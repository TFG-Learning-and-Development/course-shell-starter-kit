---
import CourseProgress from "../../src/components/CourseProgress.astro";
import ExploreGroup from "../../src/components/ExploreGroup.astro";
import type { CompletionMilestone } from "../../src/data/course-completion";
import { defaultCourseTheme, type CourseConfig } from "../../src/data/course-config";
import "../../src/styles/global.css";

const milestones: CompletionMilestone[] = [
  { id: "fixture-view", label: "View", type: "view", targetId: "fixture-view", path: "/", required: false },
  { id: "fixture-later-view", label: "Later view", type: "view", targetId: "fixture-later-view", path: "/", required: false },
  { id: "fixture-hidden-view", label: "Hidden view", type: "view", targetId: "fixture-hidden-view", path: "/", required: false },
  { id: "fixture-watch", label: "Watch", type: "watch", targetId: "fixture-watch", path: "/", required: true },
  { id: "fixture-question", label: "Question", type: "submit", targetId: "fixture-question", path: "/", required: true },
  { id: "fixture-explore", label: "Explore", type: "explore", targetId: "fixture-explore", path: "/", requiredItems: ["one", "two"], required: true },
  { id: "fixture-tabs", label: "Tabs", type: "explore", targetId: "fixture-tabs", path: "/", requiredItems: ["first", "second"], required: true },
  { id: "fixture-complete", label: "Complete event", type: "complete", targetId: "fixture-complete", path: "/", required: true },
  { id: "fixture-optional", label: "Optional event", type: "optional", targetId: "fixture-optional", path: "/", required: false },
];
const config: CourseConfig = {
  identity: { id: "verification-fixture", title: "Completion fixture", description: "" },
  brand: { homeLabel: "Fixture home" },
  theme: defaultCourseTheme,
  lessons: [{ id: "start", path: "/", label: "Start" }],
  completion: { storageKey: "astro-course-progress:verification-fixture:v1", sequentialUnlocking: true, milestones },
  package: { identifier: "verification-fixture-scorm-12", filename: "Fixture.zip", launchFile: "index.html", title: "Completion fixture" },
};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>Completion fixture</title></head>
<body><div data-course-path="/"><header class="fixture-header"><CourseProgress {config} /></header>
<main>
  <section id="fixture-view" data-completion-id="fixture-view"><h1>View fixture</h1></section>
  <section id="fixture-later-view" data-completion-id="fixture-later-view"><h2>Later view</h2></section>
  <section id="fixture-hidden-view" data-completion-id="fixture-hidden-view" hidden><h2>Hidden view</h2></section>
  <video id="fixture-watch" data-completion-id="fixture-watch"></video>
  <form id="fixture-question" data-completion-id="fixture-question"><label><input type="radio" name="answer" data-completion-option /> Any valid attempt counts</label><button type="submit">Submit</button></form>
  <ExploreGroup id="fixture-explore" title="Explore fixture" variant="accordion" items={[{ id: "one", title: "One", body: "One" }, { id: "two", title: "Two", body: "Two" }]} />
  <ExploreGroup id="fixture-tabs" title="Tab fixture" variant="tabs" items={[{ id: "first", title: "First", body: "First" }, { id: "second", title: "Second", body: "Second" }]} />
  <button id="fixture-complete" type="button" data-completion-id="fixture-complete" data-completion-trigger="complete">Complete event</button><button id="fixture-optional" type="button" data-completion-id="fixture-optional">Optional event</button>
</main></div>
<script>
  document.querySelector("#fixture-question")?.addEventListener("submit", (event) => event.preventDefault());
  document.querySelector("#fixture-complete")?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("course-progress:complete", { detail: { activityId: "fixture-complete" } })));
  document.querySelector("#fixture-optional")?.addEventListener("click", () => window.dispatchEvent(new CustomEvent("course-progress:complete", { detail: { activityId: "fixture-optional" } })));
</script>
</body></html>
<style is:global>
  body { min-width: 0; }
  .fixture-header { position: sticky; top: 0; z-index: 2; display: flex; justify-content: flex-end; min-height: 4.75rem; padding: 1rem; background: #18212b; }
  main { display: grid; gap: 3rem; padding: 1rem; }
  #fixture-view { min-height: 80vh; display: grid; place-items: center; }
  #fixture-later-view { min-height: 80vh; display: grid; place-items: center; }
</style>
