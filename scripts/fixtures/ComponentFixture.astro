<script>
  import { provideCourseState } from "../../src/lib/course-state";

  // This fixture deliberately has no CourseProgress, LMS bridge or persistent store.
  const ui = new Map<string, unknown>();
  const explored = new Map<string, Set<string>>();
  provideCourseState({
    mode: "standalone",
    learnerId: null,
    get: <T,>(key: string, fallback: T): T => (ui.has(key) ? ui.get(key) as T : fallback),
    set: (key: string, value: unknown) => { ui.set(key, value); },
    explored: (activityId: string) => [...(explored.get(activityId) || [])],
    completed: () => false,
  });
  window.addEventListener("course-progress:explore", ((event: CustomEvent<{ activityId: string; itemId: string }>) => {
    const { activityId, itemId } = event.detail;
    if (!activityId?.startsWith("gallery-") || !itemId) return;
    const items = explored.get(activityId) || new Set<string>();
    items.add(itemId);
    explored.set(activityId, items);
    window.dispatchEvent(new CustomEvent("course-progress:explore-state", { detail: { activityId, itemIds: [...items] } }));
  }) as EventListener);
  window.addEventListener("course-progress:request-restore", ((event: CustomEvent<{ activityId: string; apply?: (itemIds: string[]) => void }>) => {
    const { activityId, apply } = event.detail;
    if (!activityId?.startsWith("gallery-")) return;
    const itemIds = [...(explored.get(activityId) || [])];
    apply?.(itemIds);
    window.dispatchEvent(new CustomEvent("course-progress:explore-state", { detail: { activityId, itemIds } }));
  }) as EventListener);
</script>

