---
import DialogueBlock from "../../src/components/DialogueBlock.astro";
import InfoCallout from "../../src/components/InfoCallout.astro";
import ResponsiveTable from "../../src/components/ResponsiveTable.astro";
import SectionHeading from "../../src/components/SectionHeading.astro";
import DefinitionList from "../../src/components/typography/DefinitionList.astro";
import QuoteBlock from "../../src/components/typography/QuoteBlock.astro";
import StatisticBlock from "../../src/components/typography/StatisticBlock.astro";
import TextLayout from "../../src/components/typography/TextLayout.astro";
import TypeText from "../../src/components/typography/TypeText.astro";
import CourseCarousel from "../../src/components/CourseCarousel.astro";
import EditorialSplit from "../../src/components/EditorialSplit.astro";
import PortraitQuote from "../../src/components/PortraitQuote.astro";
import RevealGroup from "../../src/components/RevealGroup.astro";
import GalleryExample from "./GalleryExample.astro";
import PremiumAssessment from "../../src/components/PremiumAssessment.astro";
import AssessmentSequence from "../../src/components/AssessmentSequence.astro";
import FlipCards from "../../src/components/FlipCards.astro";
import MatchingActivity from "../../src/components/MatchingActivity.astro";
import StepGroup from "../../src/components/StepGroup.astro";
import ItemExplorer from "../../src/components/ItemExplorer.astro";
import FeatureHotspots from "../../src/components/FeatureHotspots.astro";
import LearningJourney from "../../src/components/LearningJourney.astro";
import ModelChoice from "../../src/components/ModelChoice.astro";
import ProductFlipcards from "../../src/components/ProductFlipcards.astro";
import DragMatching from "../../src/components/DragMatching.astro";
import ProductCatalogPattern from "../../src/components/ProductCatalogPattern.astro";
import EditorialOverlayFeature from "../../src/components/EditorialOverlayFeature.astro";
import ImageLedRangeRail from "../../src/components/ImageLedRangeRail.astro";
import ReflectionActivity from "../../src/components/ReflectionActivity.astro";
import "../../src/styles/global.css";

const columns = [
  { key: "pattern", label: "Pattern" },
  { key: "purpose", label: "Purpose" },
  { key: "notes", label: "Implementation notes" },
];
const rows = [
  {
    pattern: "Responsive table",
    purpose: "Keep structured information readable without widening the page.",
    notes: "The table region scrolls independently when its columns need more room than the viewport provides.",
  },
  {
    pattern: "Long-content check",
    purpose: "Confirm that representative prose wraps inside the shared container.",
    notes: "Course developers remain responsible for testing the actual copy, media and interaction labels used in their course.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Development component gallery</title>
  </head>
  <body>
    <main class="verification-fixture container">
      <header class="gallery-intro">
        <h1>Shared component gallery</h1>
        <p>Development preview of real course components with neutral content. Choices and responses exist only in this page session; they never reach course progress or an LMS.</p>
      </header>
      <SectionHeading title="Centred heading" intro="Short representative content." />
      <SectionHeading title="Left-aligned heading" align="left" />

      <div class="verification-callouts">
        <InfoCallout title="Pale callout" tone="pale"><p>Short content.</p></InfoCallout>
        <InfoCallout title="Slate callout" tone="slate" icon={false}><p>A callout without an icon.</p></InfoCallout>
        <InfoCallout title="Navy callout" tone="navy"><a href="#fixture-table">Focusable dark-surface content</a></InfoCallout>
      </div>

      <section id="fixture-table" aria-label="Table variants">
        <ResponsiveTable id="fixture-table-light" label="Light table fixture" {columns} {rows} />
        <ResponsiveTable id="fixture-table-dark" label="Dark table fixture" {columns} {rows} tone="dark" />
      </section>

      <DialogueBlock
        label="Dialogue fixture"
        speakerA={{ label: "Speaker A", text: "Can this component handle concise dialogue?" }}
        speakerB={[
          { label: "Speaker B", text: "Yes, and the verification fixture also checks a longer follow-up response." },
          { label: "Follow-up", text: "This representative sentence is deliberately longer so wrapping, spacing and readability can be checked at narrow and wide viewport sizes without adding demonstration content to the learner-facing starter." },
        ]}
      />

      <section class="verification-premium" aria-labelledby="premium-fixture-heading">
        <h2 id="premium-fixture-heading">Premium layout patterns</h2>
        <GalleryExample name="EditorialSplit" purpose="Pair explanatory text with a prominent image." properties="title, paragraphs, media, reverse, tone, completionId" completion="Optional VIEW milestone on the visible section when configured." usage="src/components/EditorialSplit.astro">
          <EditorialSplit title="Editorial split" paragraphs={["A development-only example with neutral local artwork."]} media={{ src: "/assets/demo/editorial-landscape.svg", alt: "Abstract landscape" }} />
        </GalleryExample>
        <GalleryExample name="PortraitQuote" purpose="Place a portrait and quotation beside supporting text." properties="title, paragraphs, portrait, quote, citation, completionId" completion="Optional VIEW milestone on the visible section when configured." usage="src/components/PortraitQuote.astro">
          <PortraitQuote title="Portrait and quote" portrait={{ src: "/assets/demo/portrait-neutral.svg", alt: "Neutral illustrated learner" }} quote="A useful quote can create editorial rhythm without becoming decoration." citation="Example voice" />
        </GalleryExample>
        <GalleryExample name="RevealGroup" purpose="Let learners open short supporting details." properties="id, title, intro, items with unique child IDs" completion="EXPLORE only when every configured required child is opened." usage="src/components/RevealGroup.astro">
          <RevealGroup id="gallery-reveals" title="Reveal group" items={[{ id: "one", title: "First reveal", body: "First detail." }, { id: "two", title: "Second reveal", body: "Second detail." }]} />
        </GalleryExample>
        <GalleryExample name="CourseCarousel" purpose="Present a short image and text sequence." properties="id, label, items, tracked" completion="Optional EXPLORE when tracked; every slide must be approved as required." usage="src/components/CourseCarousel.astro">
          <CourseCarousel id="gallery-carousel" label="Neutral carousel example" items={[{ id: "one", title: "Plan", body: "Start with the approved brief.", media: { src: "/assets/demo/item-plan.svg", alt: "Planning board illustration" } }, { id: "two", title: "Reflect", body: "Connect the idea to practice.", media: { src: "/assets/demo/item-reflect.svg", alt: "Reflection illustration" } }]} />
        </GalleryExample>
      </section>

      <section class="verification-premium" aria-labelledby="design-pattern-fixture-heading">
        <h2 id="design-pattern-fixture-heading">Design pattern references</h2>
        <GalleryExample name="Product catalog explorer · design pattern" purpose="A focused product or offer view: dark media stage, product switcher, customer context, structured details and an evidence band." properties="id, title, intro, instruction, categories, products with images/profile/details/proof, labels" completion="None by default. Use it as a visual composition; configure approved completion separately when course content requires it." usage="src/components/ProductCatalogPattern.astro and docs/patterns.md">
          <ProductCatalogPattern id="gallery-product-catalog-pattern" title="Explore the collection" intro="Compare each option through its intended use, customer context and supporting proof." instruction="Choose a category, then a product to focus the detail panel." labels={{ categoryTabs: "Collection categories", productChoices: "Products", imageViews: "Illustration views" }} categories={[{ id: "everyday", label: "Everyday" }, { id: "specialist", label: "Specialist" }]} products={[
            { id: "planner", categoryId: "everyday", name: "Planner", lead: "A practical option for creating a clear starting point.", images: [{ src: "/assets/demo/item-plan.svg", alt: "Illustrated planning board", label: "Plan view" }, { src: "/assets/demo/editorial-landscape.svg", alt: "Abstract layered landscape", label: "Context view" }], profile: { image: { src: "/assets/demo/portrait-neutral.svg", alt: "Neutral illustrated learner", label: "Customer view" }, label: "Best for", text: "Someone who needs a structured route into a task." }, details: [{ label: "Who it supports", text: "People beginning with an unfamiliar goal or sequence." }, { label: "What it helps with", text: "Turning a broad brief into visible next actions." }, { label: "How to explain it", text: "Start here when a clear path will make the choice easier." }], proof: [{ label: "Design principle", text: "Lead with the user’s need before listing features." }, { label: "Recommendation cue", text: "Use the proof band for the final fact or decision cue." }] },
            { id: "reflector", categoryId: "everyday", name: "Reflector", lead: "A calmer option for connecting an idea to practical context.", images: [{ src: "/assets/demo/item-reflect.svg", alt: "Illustrated reflection symbol", label: "Reflect view" }, { src: "/assets/demo/editorial-landscape.svg", alt: "Abstract layered landscape", label: "Context view" }], profile: { image: { src: "/assets/demo/portrait-neutral.svg", alt: "Neutral illustrated learner", label: "Customer view" }, label: "Best for", text: "Someone weighing an idea against their own experience." }, details: [{ label: "Who it supports", text: "People considering how a concept applies in practice." }, { label: "What it helps with", text: "Making a relevant personal or work connection." }, { label: "How to explain it", text: "Use it when reflection is more useful than a fixed sequence." }], proof: [{ label: "Design principle", text: "Keep the main message concise and let the details carry the proof." }, { label: "Recommendation cue", text: "Use a profile only when it sharpens the recommendation." }] },
            { id: "discussion", categoryId: "specialist", name: "Discussion guide", lead: "A focused option for comparing viewpoints in a group.", images: [{ src: "/assets/demo/item-discuss.svg", alt: "Illustrated discussion symbol", label: "Discussion view" }, { src: "/assets/demo/editorial-landscape.svg", alt: "Abstract layered landscape", label: "Context view" }], profile: { image: { src: "/assets/demo/portrait-neutral.svg", alt: "Neutral illustrated learner", label: "Customer view" }, label: "Best for", text: "A group that needs a shared lens for comparison." }, details: [{ label: "Who it supports", text: "People bringing different viewpoints to one decision." }, { label: "What it helps with", text: "Making comparisons visible without losing nuance." }, { label: "How to explain it", text: "Use it when the next useful step is a considered conversation." }], proof: [{ label: "Design principle", text: "Keep selection controls separate from the deep-dive content." }, { label: "Recommendation cue", text: "Reserve the dark proof band for content that changes a decision." }] },
          ]} />
        </GalleryExample>
        <GalleryExample name="Editorial overlay feature · design pattern" purpose="An image-led asymmetrical feature panel with a prominent subject, editorial copy and restrained construction detail." properties="id, title, paragraphs, media, optional backdrop and callout" completion="None by default. VIEW may be optional but never required." usage="src/components/EditorialOverlayFeature.astro and docs/patterns.md">
          <EditorialOverlayFeature id="gallery-editorial-overlay" title="Make the subject the focal point" paragraphs={["Pair a strong cutout or portrait with concise editorial copy, rather than turning a product story into a dense specification panel.", "The offset copy column creates contrast and protects a generous media crop."]} media={{ src: "/assets/demo/portrait-neutral.svg", alt: "Neutral illustrated learner standing beside a device" }} backdrop={{ src: "/assets/demo/editorial-landscape.svg", alt: "" }} callout="Use the decorative seam only as a quiet construction cue, never as a substitute for hierarchy." />
        </GalleryExample>
        <GalleryExample name="Image-led range rail · design pattern" purpose="A horizontally browsable range of visually led options, with a partial next card signalling that more items are available." properties="id, label, items with image/title/summary/optional detail, previousLabel, nextLabel" completion="None by default. Add only approved completion to a course that needs evidence of exploration." usage="src/components/ImageLedRangeRail.astro and docs/patterns.md">
          <ImageLedRangeRail id="gallery-image-led-range" label="Example options" previousLabel="Show previous options" nextLabel="Show next options" items={[{ id: "plan", title: "Plan", summary: "A clear starting point for a focused task.", detail: "Use the lead image to establish the character of each option.", image: { src: "/assets/demo/item-plan.svg", alt: "Illustrated planning board" } }, { id: "reflect", title: "Reflect", summary: "A calmer space for connecting idea and practice.", detail: "Keep the copy short enough to let the image lead.", image: { src: "/assets/demo/item-reflect.svg", alt: "Illustrated reflection symbol" } }, { id: "discuss", title: "Discuss", summary: "A shared lens for comparing perspectives.", detail: "Use the rail when adjacent options benefit from visual comparison.", image: { src: "/assets/demo/item-discuss.svg", alt: "Illustrated discussion symbol" } }]} />
        </GalleryExample>
      </section>

      <section class="verification-premium" aria-labelledby="interaction-fixture-heading">
        <h2 id="interaction-fixture-heading">Interaction patterns</h2>
        <GalleryExample name="PremiumAssessment · assessment" purpose="Practise one decision and see immediate feedback." properties="id, title, instruction, question prompt/options/correctIndex/feedback" completion="An intentional answer selection is a valid SUBMIT attempt, including an incorrect choice." usage="src/components/PremiumAssessment.astro">
          <PremiumAssessment id="gallery-assessment" title="Choose the useful next action" instruction="Select one response to see feedback." question={{ prompt: "A learner needs to compare two ideas. What should the activity invite them to do?", options: ["Compare the ideas against a clear criterion", "Open an unrelated image", "Wait for a timer"], correctIndex: 0, correctFeedback: "A criterion makes the comparison meaningful.", incorrectFeedback: "Choose the action that supports the comparison." }} />
        </GalleryExample>
        <GalleryExample name="PremiumAssessment · knowledge check" purpose="Check understanding with the same reusable single-choice pattern." properties="id, title, instruction, question prompt/options/correctIndex/feedback" completion="An intentional answer selection is a valid SUBMIT attempt; restoration does not create another attempt." usage="src/components/PremiumAssessment.astro">
          <PremiumAssessment id="gallery-knowledge-check" title="Check the principle" instruction="Select one response to see feedback." question={{ prompt: "Which statement describes useful feedback?", options: ["It explains the next useful step", "It only repeats the selected option"], correctIndex: 0, correctFeedback: "The next step helps learners act on the result.", incorrectFeedback: "Think about what the learner can do after reading feedback." }} />
        </GalleryExample>
        <GalleryExample name="AssessmentSequence" purpose="Present a short series of decisions one question at a time." properties="id, title, intro, instruction, questions with unique IDs and feedback, optional shuffleOptions" completion="Each question has its own SUBMIT target; an intentional selection records a valid attempt. Arrows only navigate." usage="src/components/AssessmentSequence.astro">
          <AssessmentSequence id="gallery-sequence" title="Check two decisions" questions={[{ id: "first", title: "First decision", prompt: "What should guide the component choice?", options: ["The learning goal", "The number of patterns available"], correctIndex: 0, correctFeedback: "The goal guides the choice.", incorrectFeedback: "Choose the pattern that serves the goal." }, { id: "second", title: "Second decision", prompt: "What makes feedback useful?", options: ["A relevant next step", "An unrelated fact"], correctIndex: 0, correctFeedback: "A next step helps learners act.", incorrectFeedback: "Feedback should help the learner act." }]} />
        </GalleryExample>
        <GalleryExample name="AssessmentSequence · second instance" purpose="Show that repeated sequences keep their choices separate." properties="a distinct instance ID and its own question IDs" completion="A separate SUBMIT target would be registered for this question in a course." usage="src/components/AssessmentSequence.astro">
          <AssessmentSequence id="gallery-sequence-other" title="A separate check" questions={[{ id: "single", title: "Check one decision", prompt: "What should a section heading do?", options: ["State the topic clearly", "Hide the topic"], correctIndex: 0, correctFeedback: "A clear heading orients the learner.", incorrectFeedback: "The heading should make the topic clear." }]} />
        </GalleryExample>
        <GalleryExample name="FlipCards" purpose="Reveal two sides of a short idea." properties="id, title, intro, cards with unique child IDs and front/back copy" completion="EXPLORE only after every required card is opened." usage="src/components/FlipCards.astro">
          <FlipCards id="gallery-flip-cards" title="Explore the ideas" cards={[{ id: "observe", title: "Observe", front: "Notice what is happening.", back: "Use what you notice to frame a useful question." }, { id: "respond", title: "Respond", front: "Choose a relevant action.", back: "Explain why that action fits the situation." }]} />
        </GalleryExample>
        <GalleryExample name="MatchingActivity" purpose="Match each prompt to a relevant option and review feedback." properties="id, title, intro, prompts, options, result labels" completion="A complete submitted matching attempt is a valid SUBMIT attempt." usage="src/components/MatchingActivity.astro">
          <MatchingActivity id="gallery-matching" title="Match the format" prompts={[{ id: "compare", prompt: "Compare options", answerId: "table" }, { id: "sequence", prompt: "Follow a short process", answerId: "steps" }]} options={[{ id: "steps", label: "Step group" }, { id: "table", label: "Comparison table" }]} />
        </GalleryExample>
        <GalleryExample name="StepGroup" purpose="Walk through a short ordered process with tabs and controls." properties="id, title, intro, steps with unique child IDs" completion="Each required step earns EXPLORE when its active panel is visible, including the first step." usage="src/components/StepGroup.astro">
          <StepGroup id="gallery-steps" title="A short process" steps={[{ id: "notice", title: "Notice", body: "Identify the useful fact." }, { id: "choose", title: "Choose", body: "Select an action that fits." }]} />
        </GalleryExample>
        <GalleryExample name="StepGroup · compact vertical" purpose="Keep an ordered process visible beside its explanation." properties="ordered, compactVertical, optional panelImage, and step ID/letter/title/body" completion="Each visible step earns its EXPLORE child; labels and optional letters come from content." usage="src/components/StepGroup.astro">
          <StepGroup id="gallery-compact-steps" title="Move through the process" ordered compactVertical panelImage="/assets/demo/editorial-landscape.svg" steps={[{ id: "orient", letter: "O", title: "Orient", body: "Read the approved brief." }, { id: "choose", letter: "C", title: "Choose a relevant action", body: "Select the pattern that fits." }, { id: "review", letter: "R", title: "Review", body: "Check the outcome and revise." }]} />
        </GalleryExample>
        <GalleryExample name="ItemExplorer" purpose="Browse categories, item details and local image galleries." properties="id, title, intro, categories, items with images/details" completion="Each required item earns EXPLORE when its active detail panel is visible; image changes are separate." usage="src/components/ItemExplorer.astro">
          <ItemExplorer id="gallery-explorer" title="Explore the resources" categories={[{ id: "prepare", label: "Prepare" }, { id: "apply", label: "Apply" }]} items={[{ id: "plan", categoryId: "prepare", title: "Plan", summary: "Set a clear purpose.", images: [{ src: "/assets/demo/item-plan.svg", alt: "Illustrated planning board" }, { src: "/assets/demo/editorial-landscape.svg", alt: "Abstract landscape" }], details: [{ label: "Use", text: "Shape a short learning sequence." }] }, { id: "reflect", categoryId: "apply", title: "Reflect", summary: "Connect an idea to practice.", images: [{ src: "/assets/demo/item-reflect.svg", alt: "Illustrated reflection symbol" }], details: [{ label: "Use", text: "Consider an action after learning." }] }]} />
        </GalleryExample>
        <GalleryExample name="FeatureHotspots" purpose="Explore labelled points on an image and read their supporting detail." properties="id, title, intro, image, detailPrompt, items with id/title/benefit/position, optional sayLabel/say/tip" completion="Each configured item earns EXPLORE only when its selected detail panel is visible." usage="src/components/FeatureHotspots.astro">
          <FeatureHotspots id="gallery-feature-hotspots" title="Explore the illustration" intro="Choose a numbered marker or matching detail button." image={{ src: "/assets/demo/editorial-landscape.svg", alt: "Abstract landscape with layered shapes" }} detailPrompt="Choose a point to reveal its detail." items={[{ id: "path", title: "Path", benefit: "A visible path helps learners understand what comes next.", sayLabel: "Use it when", say: "A sequence needs a clear starting point.", position: { x: 33, y: 45 } }, { id: "horizon", title: "Horizon", benefit: "A distinct horizon can give a composition depth and direction.", position: { x: 68, y: 28 } }]} tip={{ label: "Design note", text: "Use image markers only when each location adds useful meaning." }} />
        </GalleryExample>
        <GalleryExample name="LearningJourney" purpose="Show the configured course path and its live availability." properties="id, items with path/title/description/icon, currentPath, statusLabels" completion="Informational only; it reflects existing progress and lesson-unlock state." usage="src/components/LearningJourney.astro">
          <LearningJourney id="gallery-learning-journey" currentPath="/" statusLabels={{ available: "Available", current: "Current", completed: "Completed", locked: "Locked" }} items={[{ path: "/", title: "Orient", description: "Start with the course purpose.", icon: "play" }, { path: "/explore", title: "Explore", description: "Examine the key ideas.", icon: "search" }, { path: "/apply", title: "Apply", description: "Use the idea in context.", icon: "activity" }]} />
        </GalleryExample>
        <GalleryExample name="ModelChoice" purpose="Compare alternatives against a learner need and reveal relevant feedback." properties="id, title, optional intro, needsLabel, promptHeading, selectionInstruction, models, needs, guideTitle, note" completion="A selected model earns EXPLORE only when its active need panel is visible." usage="src/components/ModelChoice.astro">
          <ModelChoice id="gallery-model-choice" title="Choose an approach" intro="Compare the available approaches against each need." needsLabel="Choose a need" promptHeading="Which approach best fits?" selectionInstruction="Select an approach to see feedback." models={[{ id: "guided", title: "Guided sequence", summary: "A short, structured route through a task.", image: { src: "/assets/demo/item-plan.svg", alt: "Planning board illustration" }, guidance: "Useful when order matters." }, { id: "open", title: "Open exploration", summary: "A flexible space for learners to compare ideas.", image: { src: "/assets/demo/item-reflect.svg", alt: "Reflection illustration" }, guidance: "Useful when discussion matters." }]} needs={[{ id: "order", prompt: "Learners need a clear sequence of actions.", correctId: "guided", correctFeedback: "A guided sequence makes the order visible.", incorrectFeedback: "Choose the approach that makes the sequence clear." }, { id: "compare", prompt: "Learners need to weigh different perspectives.", correctId: "open", correctFeedback: "Open exploration supports comparison and reflection.", incorrectFeedback: "Choose the approach that leaves room for comparison." }]} guideTitle="At a glance" note="Use approved course content and assets when applying this pattern." />
        </GalleryExample>
        <GalleryExample name="ProductFlipcards" purpose="Reveal an image-led product or concept detail by turning each card." properties="id, label, optional instruction, products, labels, layout, flipStyle, presentation" completion="Each opened card earns EXPLORE when configured as a required child." usage="src/components/ProductFlipcards.astro">
          <ProductFlipcards id="gallery-product-flipcards" label="Explore the examples" instruction="Select a card to reveal its supporting detail." layout="rail" flipStyle="whole" labels={{ reveal: "Reveal detail", return: "Return to front", previous: "Previous", next: "Next" }} products={[{ id: "plan", title: "Plan", front: "Set a clear purpose before choosing a format.", backTitle: "Why it helps", back: "A clear purpose keeps the activity focused.", example: "Use the approved brief as the source of truth.", image: { src: "/assets/demo/item-plan.svg", alt: "Planning board illustration" } }, { id: "reflect", title: "Reflect", front: "Create room to consider what the idea means in practice.", backTitle: "Why it helps", back: "Reflection connects a concept to a useful next action.", image: { src: "/assets/demo/item-reflect.svg", alt: "Reflection illustration" } }]} />
        </GalleryExample>
        <GalleryExample name="DragMatching" purpose="Match answers to one or more columns using click, keyboard, drag-and-drop or a mobile picker." properties="id, label, columns, rows with answer mapping, answers, labels, optional shuffle" completion="A non-empty check is a valid SUBMIT attempt; completion rules stay configured in course data." usage="src/components/DragMatching.astro">
          <DragMatching id="gallery-drag-matching" label="Match learning purpose to pattern" columns={[{ id: "purpose", label: "Learning purpose" }, { id: "pattern", label: "Suggested pattern" }]} rows={[{ id: "compare", prompt: "Compare two ideas", answers: { purpose: "weigh", pattern: "table" } }, { id: "sequence", prompt: "Follow an ordered process", answers: { purpose: "order", pattern: "steps" } }]} answers={[{ id: "weigh", text: "Weigh differences" }, { id: "table", text: "Comparison table" }, { id: "order", text: "Make order clear" }, { id: "steps", text: "Step group" }]} labels={{ desktopInstruction: "Select an answer, then select a matching space. You can also drag an answer into place.", mobileInstruction: "Select a space to choose an answer.", answerBank: "Available answers", placeholder: "Select an answer", pickerTitle: "Choose an answer", close: "Close", clear: "Clear selection", check: "Check matches", reset: "Reset", emptyFeedback: "Place an answer in every space before checking.", correctFeedback: "All matches are correct.", incorrectFeedback: "Some matches need another look." }} shuffle={false} />
        </GalleryExample>
        <GalleryExample name="ReflectionActivity" purpose="Write and save a brief response." properties="id, title, prompt, instruction, minimumLength, buttonLabel" completion="A valid save emits COMPLETE. This preview uses in-memory storage only." usage="src/components/ReflectionActivity.astro">
          <ReflectionActivity id="gallery-reflection" title="Reflect on the example" prompt="Which pattern would support a short comparison?" instruction="This preview response stays in memory and clears when the page reloads." storageMode="memory" />
        </GalleryExample>
      </section>

      <section class="verification-typography" aria-labelledby="typography-fixture-heading">
        <h2 id="typography-fixture-heading">Typography primitives</h2>
        <div class="gallery-type-notes"><p><strong>Purpose:</strong> Keep headings, prose, quotations, statistics and definitions on the shared type scale. <strong>Editable properties:</strong> semantic element, role, layout, spacing, tone, variant and content. <strong>Completion:</strong> none by default; never make passive viewing a required milestone. <strong>Use:</strong> <code>src/components/typography/</code> and <code>docs/typography.md</code>.</p></div>
        <ul class="gallery-type-catalog">
          <li><strong>TypeText</strong> — semantic text and type roles; edit <code>as</code>, <code>role</code>, <code>weight</code>, <code>tone</code> and copy. No automatic completion. See <code>src/components/typography/TypeText.astro</code>.</li>
          <li><strong>TextLayout</strong> — readable content grids; edit <code>layout</code>, <code>spacing</code>, <code>surface</code> and slots. No automatic completion. See <code>src/components/typography/TextLayout.astro</code>.</li>
          <li><strong>QuoteBlock</strong> — editorial quotation; edit <code>quote</code>, <code>citation</code>, <code>family</code> and <code>variant</code>. No automatic completion. See <code>src/components/typography/QuoteBlock.astro</code>.</li>
          <li><strong>StatisticBlock</strong> — highlighted value with context; edit <code>value</code>, <code>label</code>, <code>detail</code> and <code>surface</code>. No automatic completion. See <code>src/components/typography/StatisticBlock.astro</code>.</li>
          <li><strong>DefinitionList</strong> — term and definition pairs; edit <code>items</code> and <code>variant</code>. No automatic completion. See <code>src/components/typography/DefinitionList.astro</code>.</li>
        </ul>

        <div class="verification-native-headings" aria-label="Native heading hierarchy">
          <h1>Native heading level one</h1>
          <h2>Native heading level two</h2>
          <h3>Native heading level three</h3>
          <h4>Native heading level four</h4>
          <h5>Native heading level five</h5>
          <h6>Native heading level six</h6>
        </div>

        <TextLayout layout="reading-standard" spacing="standard">
          <TypeText as="h3" role="heading-lg" class="verification-role-default">Semantic level three with a heading-large visual role</TypeText>
          <TypeText as="p" role="lead">A lead introduces the learning point without replacing the document heading structure.</TypeText>
          <div class="qc-text-layout__prose">
            <TypeText as="p" role="body">Body copy uses the shared reading size, line height and standard measure.</TypeText>
            <ul class="verification-list">
              <li>Keep the action and its reason together.</li>
              <li>Allow a longer learning point to wrap without clipping, overlap or an unexplained change in type size.</li>
            </ul>
