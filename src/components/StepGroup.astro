---
type Step = { id: string; title: string; body: string; letter?: string };
interface Props { id: string; title: string; intro?: string; steps: readonly Step[]; ordered?: boolean; panelImage?: string; compactVertical?: boolean }
const { id, title, intro, steps, ordered = false, panelImage, compactVertical = false } = Astro.props as Props;
---
<section class="premium-section premium-section--soft" id={id} data-completion-id={id} data-required-items={JSON.stringify(steps.map((step) => step.id))} data-step-group data-ordered={String(ordered)} aria-labelledby={`${id}-heading`}>
  <div class="container"><div class="premium-section__intro"><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}</div><div class:list={["step-group", { "step-group--compact-vertical": compactVertical }]}>
    <div class="step-group__tabs" role="tablist" aria-label={title}>{steps.map((step, index) => <button class="step-group__tab" type="button" id={`${id}-tab-${index}`} role="tab" aria-label={`Step ${index + 1} of ${steps.length}: ${step.letter ? `${step.letter} — ` : ""}${step.title}`} aria-controls={`${id}-panel-${index}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-step-index={index} data-step-id={step.id}>{compactVertical ? <>{ordered && <span class="step-group__number" aria-hidden="true">{index + 1}</span>}{step.letter && <span class="step-group__letter" aria-hidden="true">{step.letter}</span>}<span class="step-group__label" aria-hidden="true">{step.title}</span></> : step.letter ? <span class="step-group__letter" aria-hidden="true">{step.letter}</span> : <><span class="step-group__number" aria-hidden="true">{index + 1}</span><span>{step.title}</span></>}</button>)}</div>
    <div class:list={["step-group__content", { "step-group__content--image": !!panelImage }]}>{steps.map((step, index) => <section class="step-group__panel" id={`${id}-panel-${index}`} role="tabpanel" aria-labelledby={`${id}-tab-${index}`} hidden={index !== 0} style={panelImage ? `background: linear-gradient(90deg, rgb(9 17 23 / 94%) 0%, rgb(9 17 23 / 78%) 55%, rgb(9 17 23 / 45%) 100%), url('${panelImage}') center / cover` : undefined}><h3>{step.letter ? `${step.letter} — ${step.title}` : step.title}</h3><p>{step.body}</p></section>)}<div class="step-group__controls"><button class="premium-action" type="button" data-step-prev disabled>Previous</button><span data-step-count aria-live="polite">Step 1 of {steps.length}</span><button class="premium-action" type="button" data-step-next>Next</button></div></div>
  </div></div>
</section>
<script>
  import { courseStateReady } from "../lib/course-state";
  import { watchVisiblePanelExploration } from "../lib/visible-panel-exploration";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-step-group]").forEach((root) => {
    if (root.dataset.ready === "true") return; root.dataset.ready = "true";
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-step-index]")]; const tabStrip = root.querySelector<HTMLElement>(".step-group__tabs"); const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")]; const previous = root.querySelector<HTMLButtonElement>("[data-step-prev]"); const next = root.querySelector<HTMLButtonElement>("[data-step-next]"); const count = root.querySelector<HTMLElement>("[data-step-count]");
    let active = courseState.get<number>(`${root.id}:active`, 0); if (!Number.isInteger(active) || active < 0 || active >= tabs.length) active = 0;
    const creditVisible = watchVisiblePanelExploration({ root, panels, activePanel: () => panels[active], itemId: (panel) => tabs[panels.indexOf(panel)]?.dataset.stepId, courseState });
    const show = (index: number, focus = false, record = true) => { active = index; tabs.forEach((tab, position) => { tab.setAttribute("aria-selected", String(position === index)); tab.tabIndex = position === index ? 0 : -1; panels[position].hidden = position !== index; }); if (previous) previous.disabled = index === 0; if (next) next.disabled = index === tabs.length - 1; if (count) count.textContent = `Step ${index + 1} of ${tabs.length}`; if (focus) tabs[index]?.focus(); if (tabStrip && tabStrip.scrollWidth > tabStrip.clientWidth) { const tabBox = tabs[index].getBoundingClientRect(); const stripBox = tabStrip.getBoundingClientRect(); tabStrip.scrollLeft += tabBox.left - stripBox.left - (stripBox.width - tabBox.width) / 2; } if (record) { courseState.set(`${root.id}:active`, index); creditVisible(); } };
    tabs.forEach((tab, index) => { tab.addEventListener("click", () => show(index)); tab.addEventListener("keydown", (event) => { const target = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : ["ArrowRight", "ArrowDown"].includes(event.key) ? (index + 1) % tabs.length : ["ArrowLeft", "ArrowUp"].includes(event.key) ? (index - 1 + tabs.length) % tabs.length : null; if (target === null) return; event.preventDefault(); show(target, true); }); });
    previous?.addEventListener("click", () => show(Math.max(0, active - 1))); next?.addEventListener("click", () => show(Math.min(tabs.length - 1, active + 1)));
    show(active, false, false);
  }));
</script>
