---
type Step = { id: string; title: string; body: string };
interface Props { id: string; title: string; intro?: string; steps: readonly Step[] }
const { id, title, intro, steps } = Astro.props as Props;
---
<section class="premium-section premium-section--soft" id={id} data-completion-id={id} data-required-items={JSON.stringify(steps.map((step) => step.id))} data-step-group aria-labelledby={`${id}-heading`}>
  <div class="container"><div class="premium-section__intro"><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}<p data-step-status aria-live="polite">0 of {steps.length} steps explored</p></div><div class="step-group">
    <div class="step-group__tabs" role="tablist" aria-label={title}>{steps.map((step, index) => <button class="step-group__tab" type="button" id={`${id}-tab-${index}`} role="tab" aria-controls={`${id}-panel-${index}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} data-step-index={index} data-step-id={step.id}><span class="step-group__number">{index + 1}</span><span>{step.title}</span></button>)}</div>
    <div class="step-group__content">{steps.map((step, index) => <section class="step-group__panel" id={`${id}-panel-${index}`} role="tabpanel" aria-labelledby={`${id}-tab-${index}`} hidden={index !== 0}><h3>{step.title}</h3><p>{step.body}</p></section>)}<div class="step-group__controls"><button class="premium-action" type="button" data-step-prev disabled>Previous</button><span data-step-count aria-live="polite">Step 1 of {steps.length}</span><button class="premium-action" type="button" data-step-next>Next</button></div></div>
  </div></div>
</section>
<script>
  import { courseStateReady } from "../lib/course-state";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-step-group]").forEach((root) => {
    if (root.dataset.ready === "true") return; root.dataset.ready = "true";
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-step-index]")]; const panels = [...root.querySelectorAll<HTMLElement>("[role=tabpanel]")]; const previous = root.querySelector<HTMLButtonElement>("[data-step-prev]"); const next = root.querySelector<HTMLButtonElement>("[data-step-next]"); const count = root.querySelector<HTMLElement>("[data-step-count]"); const status = root.querySelector<HTMLElement>("[data-step-status]"); const visited = new Set(courseState.explored(root.id));
    let active = courseState.get<number>(`${root.id}:active`, 0); if (!Number.isInteger(active) || active < 0 || active >= tabs.length) active = 0;
    const renderStatus = () => { if (status) status.textContent = `${visited.size} of ${tabs.length} steps explored`; };
    const creditVisible = () => { const panel = panels[active]; const itemId = tabs[active]?.dataset.stepId; if (!panel || !itemId || panel.hidden || document.visibilityState !== "visible" || panel.closest("[hidden]") || visited.has(itemId)) return; const box = panel.getBoundingClientRect(); if (box.width && box.height && box.bottom > 0 && box.top < innerHeight) window.dispatchEvent(new CustomEvent("course-progress:explore", { detail: { activityId: root.id, itemId } })); };
    const show = (index: number, focus = false, record = true) => { active = index; tabs.forEach((tab, position) => { tab.setAttribute("aria-selected", String(position === index)); tab.tabIndex = position === index ? 0 : -1; panels[position].hidden = position !== index; }); if (previous) previous.disabled = index === 0; if (next) next.disabled = index === tabs.length - 1; if (count) count.textContent = `Step ${index + 1} of ${tabs.length}`; if (focus) tabs[index]?.focus(); if (record) { courseState.set(`${root.id}:active`, index); creditVisible(); } };
    tabs.forEach((tab, index) => { tab.addEventListener("click", () => show(index)); tab.addEventListener("keydown", (event) => { const target = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : ["ArrowRight", "ArrowDown"].includes(event.key) ? (index + 1) % tabs.length : ["ArrowLeft", "ArrowUp"].includes(event.key) ? (index - 1 + tabs.length) % tabs.length : null; if (target === null) return; event.preventDefault(); show(target, true); }); });
    previous?.addEventListener("click", () => show(Math.max(0, active - 1))); next?.addEventListener("click", () => show(Math.min(tabs.length - 1, active + 1)));
    window.addEventListener("course-progress:explore-state", ((event: CustomEvent<{ activityId: string; itemIds: string[] }>) => { if (event.detail.activityId !== root.id) return; event.detail.itemIds.forEach((item) => visited.add(item)); renderStatus(); }) as EventListener);
    show(active, false, false); renderStatus();
    const observer = new IntersectionObserver(() => creditVisible(), { threshold: 0.01 });
    panels.forEach((panel) => observer.observe(panel));
    document.addEventListener("visibilitychange", creditVisible);
    requestAnimationFrame(creditVisible);
  }));
</script>
