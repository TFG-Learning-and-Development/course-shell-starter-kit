---
import type { AssessmentSequenceQuestion } from "./premium-types";

interface Props {
  id: string;
  title: string;
  intro?: string;
  instruction?: string;
  questions: readonly AssessmentSequenceQuestion[];
  shuffleOptions?: boolean;
}
const { id, title, intro, instruction = "Select an answer to see feedback.", questions, shuffleOptions = false } = Astro.props as Props;
if (!questions.length || new Set(questions.map((question) => question.id)).size !== questions.length ||
  questions.some((question) => !/^[a-z][a-z0-9-]*$/.test(question.id) || question.options.length < 2 ||
    !Number.isInteger(question.correctIndex) || question.correctIndex < 0 || question.correctIndex >= question.options.length ||
    !question.title.trim() || !question.prompt.trim() || !question.correctFeedback.trim() || !question.incorrectFeedback.trim())) {
  throw new Error(`Invalid assessment sequence configuration: ${id}`);
}
const runtime = JSON.stringify({ id, questions, shuffleOptions }).replaceAll("<", "\\u003c");
---
<section class="premium-section premium-assessment-section" id={id} data-assessment-sequence aria-labelledby={`${id}-heading`}>
  <div class="container">
    <div class="premium-assessment assessment-sequence__shell">
      <h2 id={`${id}-heading`}>{title}</h2>
      {intro && <p class="assessment-sequence__intro">{intro}</p>}
      {questions.map((question, questionIndex) => (
        <form class="assessment-sequence__form" id={`${id}-${question.id}`} data-completion-id={`${id}-${question.id}`} data-question-id={question.id} hidden={questionIndex !== 0} novalidate>
          <div class="premium-assessment__layout">
            <div class="premium-assessment__question-column">
              <div class="premium-assessment__question-card">
                <span class="premium-assessment__question-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></span>
                <div class="premium-assessment__question-copy"><h3>{question.title}</h3><p>{question.prompt}</p><p><strong>{instruction}</strong></p></div>
              </div>
              <div class="premium-assessment__feedback" data-answer-feedback role="status" aria-live="polite" aria-atomic="true">
                <span class="premium-assessment__feedback-icon" aria-hidden="true">✓</span><p data-feedback-copy></p>
              </div>
            </div>
            <fieldset class="premium-assessment__answers">
              <legend class="sr-only">{question.prompt}</legend>
              {question.options.map((option, optionIndex) => <label class="premium-assessment__option" data-option-card><input type="radio" name={`${id}-${question.id}-answer`} value={optionIndex} data-completion-option /><span>{option}</span></label>)}
            </fieldset>
          </div>
        </form>
      ))}
      <div class="assessment-sequence__navigation">
        <span class="assessment-sequence__count" data-question-count aria-live="polite">Question 1 of {questions.length}</span>
        <button class="assessment-sequence__arrow" type="button" data-question-prev aria-label="Previous question" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 5-7 7 7 7"/><path d="M7 12h13"/></svg></button>
        <button class="assessment-sequence__arrow" type="button" data-question-next aria-label="Next question" disabled={questions.length === 1}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m10 5 7 7-7 7"/><path d="M17 12H4"/></svg></button>
      </div>
    </div>
  </div>
  <script type="application/json" data-sequence-config set:html={runtime}></script>
</section>
<script>
  import { courseStateReady } from "../lib/course-state";
  import type { AssessmentSequenceQuestion } from "./premium-types";

  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-assessment-sequence]").forEach((root) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const node = root.querySelector<HTMLScriptElement>("[data-sequence-config]");
    if (!node?.textContent) return;
    const config = JSON.parse(node.textContent) as { id: string; questions: AssessmentSequenceQuestion[]; shuffleOptions: boolean };
    const forms = [...root.querySelectorAll<HTMLFormElement>("[data-question-id]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-question-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-question-next]");
    const count = root.querySelector<HTMLElement>("[data-question-count]");
    const answers: Record<string, number> = {};
    config.questions.forEach((question) => {
      const saved = courseState.get<number | null>(`${config.id}:${question.id}:answer`, null);
      if (Number.isInteger(saved) && saved! >= 0 && saved! < question.options.length) answers[question.id] = saved!;
    });
    let active = courseState.get<number>(`${config.id}:active`, 0);
    if (!Number.isInteger(active) || active < 0 || active >= forms.length) active = 0;

    const renderAnswer = (form: HTMLFormElement, question: AssessmentSequenceQuestion) => {
      const selected = answers[question.id];
      const inputs = [...form.querySelectorAll<HTMLInputElement>("input[data-completion-option]")];
      const feedback = form.querySelector<HTMLElement>("[data-answer-feedback]");
      const copy = form.querySelector<HTMLElement>("[data-feedback-copy]");
      const valid = Number.isInteger(selected) && selected >= 0 && selected < inputs.length;
      inputs.forEach((input) => { input.checked = valid && Number(input.value) === selected; });
      if (!feedback || !copy) return;
      if (!valid) { delete feedback.dataset.result; delete form.dataset.result; copy.textContent = ""; return; }
      const correct = selected === question.correctIndex;
      const result = correct ? "correct" : "incorrect";
      feedback.dataset.result = result;
      form.dataset.result = result;
      copy.textContent = `${correct ? "Correct response." : "Incorrect response."} ${correct ? question.correctFeedback : question.incorrectFeedback}`;
    };

    forms.forEach((form, index) => {
      const question = config.questions[index];
      if (!question) return;
      if (config.shuffleOptions) {
        const cards = [...form.querySelectorAll<HTMLElement>("[data-option-card]")];
        for (let position = cards.length - 1; position > 0; position -= 1) {
          const swap = Math.floor(Math.random() * (position + 1));
          [cards[position], cards[swap]] = [cards[swap], cards[position]];
        }
        cards.forEach((card) => form.querySelector("fieldset")?.append(card));
      }
      form.addEventListener("submit", (event) => event.preventDefault());
      form.addEventListener("change", (event) => {
        if (!(event.target instanceof HTMLInputElement) || !event.target.matches("input[data-completion-option]") || !event.target.checked) return;
        const selected = Number(event.target.value);
        if (selected === answers[question.id] && form.dataset.result) return;
        answers[question.id] = selected;
        courseState.set(`${config.id}:${question.id}:answer`, selected);
        renderAnswer(form, question);
        form.requestSubmit();
      });
      renderAnswer(form, question);
    });

    const show = (index: number, focus = false, record = true) => {
      active = Math.max(0, Math.min(forms.length - 1, index));
      forms.forEach((form, position) => { form.hidden = position !== active; });
      if (count) count.textContent = `Question ${active + 1} of ${forms.length}`;
      if (previous) previous.disabled = active === 0;
      if (next) next.disabled = active === forms.length - 1;
      if (record) courseState.set(`${config.id}:active`, active);
      if (focus) {
        const heading = forms[active]?.querySelector<HTMLElement>("h3");
        heading?.setAttribute("tabindex", "-1");
        heading?.focus({ preventScroll: true });
        heading?.scrollIntoView({ block: "start", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
      }
    };
    previous?.addEventListener("click", () => show(active - 1, true));
    next?.addEventListener("click", () => show(active + 1, true));
    window.addEventListener("course-progress:reveal-target", ((event: CustomEvent<{ targetId: string }>) => {
      const index = forms.findIndex((form) => form.id === event.detail.targetId);
      if (index >= 0) show(index, true);
    }) as EventListener);
    show(active, false, false);
  }));
</script>
<style>
  .assessment-sequence__shell { background: linear-gradient(145deg, color-mix(in srgb, var(--course-surface-strong) 76%, white), var(--course-surface-strong) 58%, #101519); }
  .assessment-sequence__shell > h2 { margin-bottom: var(--course-space-heading-copy); }
  .assessment-sequence__intro { max-width: var(--course-type-measure-standard); margin: 0 0 var(--course-space-intro-interaction); color: #ecf2f5; }
  .assessment-sequence__form[hidden] { display: none; }
  .assessment-sequence__form .premium-assessment__question-copy h3 { margin: 0 0 var(--course-space-heading-copy); font-size: var(--course-type-heading-sm-size); line-height: var(--course-type-heading-line-height); }
  .assessment-sequence__form .premium-assessment__feedback:not([data-result]) { min-height: 0; height: 0; margin: 0; padding: 0; border: 0; }
  .assessment-sequence__navigation { display: flex; align-items: center; justify-content: flex-end; gap: .7rem; margin-top: var(--course-space-grid); }
  .assessment-sequence__count { display: inline-flex; min-height: 3rem; align-items: center; padding: .65rem 1.1rem; border: 1px solid rgb(255 255 255 / 38%); border-radius: 999px; color: #fff; background: rgb(255 255 255 / 10%); font-size: var(--course-type-ui-size); font-weight: 700; white-space: nowrap; }
  .assessment-sequence__arrow { display: grid; width: 3rem; height: 3rem; flex: 0 0 3rem; place-items: center; padding: 0; border: 1px solid rgb(255 255 255 / 55%); border-radius: 50%; color: #fff; background: var(--course-accent-strong); cursor: pointer; transition: background-color 160ms ease, transform 160ms ease; }
  .assessment-sequence__arrow svg { width: 1.35rem; height: 1.35rem; }
  .assessment-sequence__arrow:hover:not(:disabled) { background: var(--course-accent); transform: translateY(-2px); }
  .assessment-sequence__arrow:disabled { color: #bfc9ce; background: rgb(255 255 255 / 12%); cursor: not-allowed; }
  .assessment-sequence__arrow:focus-visible { outline: .2rem solid #fff; outline-offset: .2rem; }
  @media (max-width: 30rem) { .assessment-sequence__navigation { gap: .45rem; } .assessment-sequence__count { flex: 1 1 auto; justify-content: center; padding-inline: .55rem; } .assessment-sequence__arrow { width: 2.75rem; height: 2.75rem; flex-basis: 2.75rem; } }
  @media (prefers-reduced-motion: reduce) { .assessment-sequence__arrow { transition: none; } .assessment-sequence__arrow:hover:not(:disabled) { transform: none; } }
</style>
