---
import type { HeritageMilestone } from "../data/course";

interface Props {
  milestone: HeritageMilestone;
}

const { milestone } = Astro.props as Props;
const panelId = `heritage-detail-${milestone.id}`;
---

<article class="heritage-card" data-heritage-card={milestone.id}>
  <button class="heritage-trigger" type="button" aria-expanded="false" aria-controls={panelId}>
    <span class="heritage-card-heading">
      <span>
        {milestone.year && <span class="heritage-year">{milestone.year}</span>}
        <span class="heritage-title">{milestone.title}</span>
      </span>
      <img src={milestone.image} alt={milestone.imageAlt} />
    </span>
    <span class="heritage-prompt">
      <span class="heritage-prompt-label">Reveal story</span>
      <span class="heritage-plus" aria-hidden="true"></span>
    </span>
  </button>
  <div class="heritage-detail" id={panelId} hidden>
    <p>{milestone.detail}</p>
    <p><strong>Why it matters to Customers:</strong> {milestone.customerMeaning}</p>
  </div>
</article>
