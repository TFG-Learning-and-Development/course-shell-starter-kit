---
import { courseConfig } from "../data/course-config";
interface Props { id: string; title: string; prompt: string; instruction?: string; minimumLength?: number; buttonLabel?: string; storageMode?: "course" | "memory" }
const { id, title, prompt, instruction, minimumLength = 1, buttonLabel = "Save response", storageMode = "course" } = Astro.props as Props;
const config = { id, courseKey: courseConfig.completion.storageKey, minimumLength, storageMode };
---
<section class="premium-section premium-section--dark" aria-labelledby={`${id}-heading`}><div class="container"><form class="reflection-activity" id={id} data-completion-id={id} data-reflection-activity>
  <h2 id={`${id}-heading`}>{title}</h2><label for={`${id}-response`}>{prompt}</label>{instruction && <p id={`${id}-instruction`}>{instruction}</p>}<textarea id={`${id}-response`} rows="6" aria-describedby={instruction ? `${id}-instruction` : undefined}></textarea><div><button class="premium-action" type="submit">{buttonLabel}</button></div><p class="reflection-activity__status" data-reflection-status role="status" aria-live="polite"></p><script type="application/json" data-reflection-config set:html={JSON.stringify(config)}></script>
</form></div></section>
<script>
  import { courseStateReady } from "../lib/course-state";
  import { reflectionStorageKey, restoreReflection, saveReflection } from "../lib/reflection-storage";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLFormElement>("[data-reflection-activity]").forEach((form) => {
    if (form.dataset.ready === "true") return; form.dataset.ready = "true"; const node = form.querySelector<HTMLScriptElement>("[data-reflection-config]"); if (!node?.textContent) return; const config = JSON.parse(node.textContent) as { id: string; courseKey: string; minimumLength: number; storageMode: "course" | "memory" }; const input = form.querySelector<HTMLTextAreaElement>("textarea"); const status = form.querySelector<HTMLElement>("[data-reflection-status]"); const key = config.storageMode === "memory" ? null : reflectionStorageKey(config.courseKey, config.id, courseState); if (input) input.value = config.storageMode === "memory" ? courseState.get<string>(`${config.id}:reflection`, "") : restoreReflection(key);
    form.addEventListener("submit", (event) => { event.preventDefault(); const value = input?.value.trim() || ""; if (value.length < config.minimumLength) { if (status) status.textContent = `Add at least ${config.minimumLength} characters before saving.`; return; } const saved = config.storageMode === "memory" ? (courseState.set(`${config.id}:reflection`, value), true) : saveReflection(key, value); if (!saved) { if (status) status.textContent = key ? "Your response could not be saved in this browser." : "This LMS session cannot safely store personal reflection text."; return; } if (status) status.textContent = config.storageMode === "memory" ? "Response saved for this preview session." : "Response saved."; window.dispatchEvent(new CustomEvent("course-progress:complete", { detail: { activityId: config.id } })); });
  }));
</script>
