---
import { courseConfig } from "../data/course-config";
interface Props { id: string; title: string; prompt: string; instruction?: string; minimumLength?: number; buttonLabel?: string; storageMode?: "course" | "memory"; requireDurableStorage?: boolean; courseKey?: string }
const { id, title, prompt, instruction, minimumLength = 1, buttonLabel = "Save response", storageMode = "course", requireDurableStorage = false, courseKey = courseConfig.completion.storageKey } = Astro.props as Props;
const config = { id, courseKey, minimumLength, storageMode, requireDurableStorage };
---
<section class="premium-section premium-section--dark" aria-labelledby={`${id}-heading`}><div class="container"><form class="reflection-activity" id={id} data-completion-id={id} data-completion-trigger="complete" data-reflection-activity>
  <h2 id={`${id}-heading`}>{title}</h2><label for={`${id}-response`}>{prompt}</label>{instruction && <p id={`${id}-instruction`}>{instruction}</p>}<textarea id={`${id}-response`} rows="6" aria-describedby={instruction ? `${id}-instruction` : undefined}></textarea><div><button class="premium-action" type="submit">{buttonLabel}</button></div><p class="reflection-activity__status" data-reflection-status role="status" aria-live="polite"></p><script type="application/json" data-reflection-config set:html={JSON.stringify(config)}></script>
</form></div></section>
<script>
  import { courseStateReady } from "../lib/course-state";
  import { reflectionStorageKey, restoreReflection, saveReflection, restoreSessionReflection, saveSessionReflection } from "../lib/reflection-storage";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLFormElement>("[data-reflection-activity]").forEach((form) => {
    if (form.dataset.ready === "true") return; form.dataset.ready = "true"; const node = form.querySelector<HTMLScriptElement>("[data-reflection-config]"); if (!node?.textContent) return; const config = JSON.parse(node.textContent) as { id: string; courseKey: string; minimumLength: number; storageMode: "course" | "memory"; requireDurableStorage: boolean }; const input = form.querySelector<HTMLTextAreaElement>("textarea"); const status = form.querySelector<HTMLElement>("[data-reflection-status]"); const key = config.storageMode === "memory" ? null : reflectionStorageKey(config.courseKey, config.id, courseState); const sessionKey = `${config.courseKey}:${config.id}`; if (input) input.value = key ? restoreReflection(key) : restoreSessionReflection(sessionKey);
    form.addEventListener("submit", (event) => { event.preventDefault(); const value = input?.value.trim() || ""; if (value.length < config.minimumLength) { if (status) status.textContent = `Add at least ${config.minimumLength} characters before saving.`; return; } if (courseState.mode === "failed") { if (status) status.textContent = "The LMS session is unavailable. Your response was not recorded."; return; } const saved = key && config.storageMode === "course" && saveReflection(key, value); if (!saved && config.requireDurableStorage) { if (status) status.textContent = "Private browser storage is unavailable. This activity requires a saved response; try again when storage is available."; return; } if (!saved) saveSessionReflection(sessionKey, value); if (status) status.textContent = saved ? "Response saved privately in this browser." : "Response recorded for this open page only. Your text will not be available after leaving or refreshing."; window.dispatchEvent(new CustomEvent("course-progress:complete", { detail: { activityId: config.id } })); });
  }));
</script>
