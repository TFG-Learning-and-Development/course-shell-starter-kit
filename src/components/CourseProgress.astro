  :global(.course-progress__completed-group summary:focus-visible) { outline: 2px solid var(--focus-on-light); outline-offset: 3px; }
  :global(.course-progress__completed-group ul) { margin-top: 7px; }
  :global(.course-progress__completed-group li) { display: flex; gap: 7px; color: #435261; }
