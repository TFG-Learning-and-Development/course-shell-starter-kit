  @media (max-width: 64rem) {
    .course-progress__trigger { min-height: 2.75rem; padding-inline: 0.6rem; }
    .course-progress__panel { right: 0; max-height: calc(100dvh - 5.75rem); }
  }
  @media (prefers-reduced-motion: reduce) { .course-progress__bar span, :global(.course-progress__lesson-bar span) { transition: none; } }
</style>
