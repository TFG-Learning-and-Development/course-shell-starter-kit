---
import type { CourseConfig } from "../data/course-config";

interface Props {
  config: CourseConfig;
}

const { config } = Astro.props as Props;
const runtimeConfig = { lessons: config.lessons, sections: config.sections || [], ...config.completion };
---

<div class="course-progress" data-course-progress>
  <button
    class="course-progress__trigger"
    type="button"
    data-progress-trigger
    aria-label="Open activity progress (0% complete)"
    aria-expanded="false"
    aria-controls="course-progress-panel"
  >
    <span>Progress</span>
    <strong data-progress-percent>0%</strong>
  </button>

  <aside class="course-progress__panel" id="course-progress-panel" aria-label="Activity progress" aria-hidden="true" data-progress-panel inert hidden>
    <div class="course-progress__header">
      <div>
        <p>Activity progress</p>
        <strong data-progress-value aria-live="polite">0% complete</strong>
        <p class="course-progress__course-count" data-progress-course-count>Course required activities: 0 of 0 completed</p>
      </div>
      <button class="course-progress__close" type="button" data-progress-close aria-label="Close activity progress">&times;</button>
    </div>
    <div class="course-progress__bar" role="progressbar" aria-label="Activity completion" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-bar><span data-progress-bar-fill></span></div>
    <div class="course-progress__lessons" data-progress-lessons></div>
  </aside>
  <p class="course-progress__save-error" data-progress-save-error role="alert" hidden>Progress could not be saved. Keep this page open and try again.</p>

  <script type="application/json" data-course-progress-config set:html={JSON.stringify(runtimeConfig).replaceAll("<", "\\u003c")}></script>
</div>

<script>
  import { ScormSession } from "../lib/scorm";
  import { provideCourseState } from "../lib/course-state";
  import { courseUrl } from "../lib/course-url";

  type RangePair = [number, number];
  type PersistedState = { completed: string[]; watchRanges: Record<string, RangePair[]>; watchDurations: Record<string, number>; explored: Record<string, string[]>; ui: Record<string, unknown> };
  type Milestone = { id: string; label: string; type: "view" | "watch" | "submit" | "explore" | "complete" | "optional"; targetId: string; path?: string; requiredItems?: string[]; required: boolean; threshold?: number };

  document.querySelectorAll<HTMLElement>("[data-course-progress]").forEach(async (root) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const configNode = root.querySelector<HTMLScriptElement>("[data-course-progress-config]");
    const config = configNode?.textContent ? JSON.parse(configNode.textContent) : null;
    if (!config) return;

    const milestones = config.milestones as Milestone[];
    const lessons = config.lessons as { id: string; path: string; label: string }[];
    const sections = config.sections as { id: string; label: string; milestoneIds: string[] }[];
    const requiredMilestones = milestones.filter((milestone) => milestone.required);
    const sequentialUnlocking = config.sequentialUnlocking === true;
    const currentPath = document.querySelector<HTMLElement>("[data-course-path]")?.dataset.coursePath || location.pathname;
    const storageKey = String(config.storageKey || "astro-course-progress");
    const signatureSource = JSON.stringify(milestones.map(({ id, path, type, targetId, requiredItems, threshold, required }) => [id, path, type, targetId, requiredItems || [], threshold ?? null, required]));
    let signatureHash = 0xcbf29ce484222325n;
    for (const character of signatureSource) signatureHash = BigInt.asUintN(64, (signatureHash ^ BigInt(character.charCodeAt(0))) * 0x100000001b3n);
    const signature = signatureHash.toString(16).padStart(16, "0");
    const defaultState = (): PersistedState => ({ completed: [], watchRanges: {}, watchDurations: {}, explored: {}, ui: {} });
    const milestoneIds = new Set(milestones.map((milestone) => milestone.id));
    const maxUiChars = 1800;
    const maxSuspendChars = 4096;
    const validUiValue = (value: unknown, depth = 0): boolean => {
      if (depth > 4) return false;
      if (value === null || typeof value === "boolean") return true;
      if (typeof value === "number") return Number.isSafeInteger(value) && value >= 0 && value < 1000;
      if (typeof value === "string") return value.length <= 64;
      if (Array.isArray(value)) return value.length <= 32 && value.every((item) => validUiValue(item, depth + 1));
      if (typeof value === "object") return Object.entries(value).length <= 8 && Object.entries(value).every(([key, item]) => key.length <= 64 && validUiValue(item, depth + 1));
      return false;
    };
    const validUi = (ui: Record<string, unknown>) => {
      try {
        const json = JSON.stringify(ui);
        return Boolean(json && json.length <= maxUiChars && Object.keys(ui).length <= 64 &&
          Object.entries(ui).every(([key, value]) => key.length <= 64 && validUiValue(value)));
      } catch { return false; }
    };
    const validState = (value: unknown): PersistedState | null => {
      if (!value || typeof value !== "object") return null;
      const candidate = value as PersistedState;
      if (!Array.isArray(candidate.completed) || !candidate.completed.every((id) => typeof id === "string" && milestoneIds.has(id))) return null;
      if (!candidate.watchRanges || typeof candidate.watchRanges !== "object" || Array.isArray(candidate.watchRanges)) return null;
      if (!candidate.watchDurations || typeof candidate.watchDurations !== "object" || Array.isArray(candidate.watchDurations)) return null;
      if (!candidate.explored || typeof candidate.explored !== "object" || Array.isArray(candidate.explored)) return null;
      if (!candidate.ui || typeof candidate.ui !== "object" || Array.isArray(candidate.ui)) return null;
      if (!validUi(candidate.ui)) return null;
      for (const [id, ranges] of Object.entries(candidate.watchRanges)) {
        if (milestones.find((item) => item.id === id)?.type !== "watch" || !Array.isArray(ranges) ||
          !ranges.every((range) => Array.isArray(range) && range.length === 2 && range.every((number) => typeof number === "number" && Number.isFinite(number) && number >= 0) && range[1] > range[0])) return null;
      }
      for (const [id, duration] of Object.entries(candidate.watchDurations)) {
        if (milestones.find((item) => item.id === id)?.type !== "watch" || typeof duration !== "number" || !Number.isFinite(duration) || duration <= 0) return null;
      }
      for (const [id, items] of Object.entries(candidate.explored)) {
        const milestone = milestones.find((item) => item.id === id);
        if (milestone?.type !== "explore" || !Array.isArray(items)) return null;
        const target = milestone.path && milestone.path !== currentPath ? null : document.getElementById(milestone.targetId);
        let requiredItems: string[] = [];
        try { requiredItems = target ? JSON.parse(target.dataset.requiredItems || "[]") : milestone.requiredItems || []; } catch { return null; }
        if (!Array.isArray(requiredItems) || requiredItems.length === 0 || !items.every((item) => typeof item === "string" && requiredItems.includes(item))) return null;
      }
      for (const id of candidate.completed) {
        const milestone = milestones.find((item) => item.id === id)!;
        if (milestone.type === "explore") {
          const target = milestone.path && milestone.path !== currentPath ? null : document.getElementById(milestone.targetId);
          let requiredItems: string[] = [];
          try { requiredItems = target ? JSON.parse(target.dataset.requiredItems || "[]") : milestone.requiredItems || []; } catch { return null; }
          if (!requiredItems.length || !requiredItems.every((item) => candidate.explored[id]?.includes(item))) return null;
        }
        if (milestone.type === "watch") {
          const ranges = candidate.watchRanges[id];
          if (!ranges?.length) return null;
          const duration = candidate.watchDurations[id];
          if (duration) {
            const ordered = [...ranges].sort((left, right) => left[0] - right[0]);
            let covered = 0; let end = 0;
            for (const [start, stop] of ordered) { if (stop > duration + 0.01) return null; covered += Math.max(0, stop - Math.max(start, end)); end = Math.max(end, stop); }
            if (covered / duration + 0.0001 < (milestone.threshold ?? 0.8)) return null;
          }
        }
      }
      return candidate;
    };
    let discardedLegacyUi = false;
    const fromSuspendData = (raw: string): PersistedState | null => {
      try {
        const compact = JSON.parse(raw);
        if (compact.v !== storageKey || compact.s !== signature || !Array.isArray(compact.c) || !compact.w || !compact.e) return null;
        const idAt = (index: number) => Number.isInteger(index) ? milestones[index]?.id : undefined;
        const completed = compact.c.map(idAt);
        const watchRanges = Object.fromEntries(Object.entries(compact.w).map(([index, ranges]) => [idAt(Number(index)), ranges]));
        const watchDurations = Object.fromEntries(Object.entries(compact.d || {}).map(([index, duration]) => [idAt(Number(index)), duration]));
        const explored = Object.fromEntries(Object.entries(compact.e).map(([index, items]) => [idAt(Number(index)), items]));
        const essential = { completed, watchRanges, watchDurations, explored, ui: {} };
        if (!validState(essential)) return null;
        const restored = validState({ ...essential, ui: compact.u || {} });
        if (restored) return restored;
        discardedLegacyUi = true;
        return essential;
      } catch { return null; }
    };
    const toSuspendData = (snapshot = state) => {
      const indexOf = (id: string) => milestones.findIndex((milestone) => milestone.id === id);
      return JSON.stringify({
        v: storageKey,
        s: signature,
        c: snapshot.completed.map(indexOf),
        w: Object.fromEntries(Object.entries(snapshot.watchRanges).map(([id, ranges]) => [indexOf(id), ranges])),
        d: Object.fromEntries(Object.entries(snapshot.watchDurations).map(([id, duration]) => [indexOf(id), duration])),
        e: Object.fromEntries(Object.entries(snapshot.explored).map(([id, items]) => [indexOf(id), items])),
        u: snapshot.ui,
      });
    };
    const scorm = new ScormSession();
    const launch = await scorm.launch();
    const parentManaged = scorm.parentManaged;
    let state = defaultState();
    let lmsStateValid = true;
    let restoredFromLms = false;
    if (launch.mode === "lms" && launch.suspendData) {
      const restored = fromSuspendData(launch.suspendData);
      if (restored) { state = restored; restoredFromLms = true; }
      else {
        lmsStateValid = false;
        console.error("[scorm] Invalid or version-mismatched cmi.suspend_data; progress is read-only to preserve the existing LMS record.");
      }
    } else if (launch.mode === "standalone") {
      try {
        const saved = window.localStorage.getItem(storageKey);
        if (saved) {
          const parsed = JSON.parse(saved);
          const compatible = {
            completed: Array.isArray(parsed.completed) ? parsed.completed.filter((id: unknown) => typeof id === "string" && milestoneIds.has(id)) : [],
            watchRanges: Object.fromEntries(Object.entries(parsed.watchRanges || {}).filter(([id]) => milestones.some((item) => item.id === id && item.type === "watch"))),
            watchDurations: Object.fromEntries(Object.entries(parsed.watchDurations || {}).filter(([id]) => milestones.some((item) => item.id === id && item.type === "watch"))),
            explored: Object.fromEntries(Object.entries(parsed.explored || {}).filter(([id]) => milestones.some((item) => item.id === id && item.type === "explore"))),
            ui: parsed.ui || {},
          };
          state = validState(compatible) || defaultState();
        }
      } catch { state = defaultState(); }
    }

    const completed = new Set(state.completed.filter((id) => milestones.some((milestone) => milestone.id === id)));
    const lessonPaths = lessons.map((lesson) => lesson.path);
    const lessonRequirements = lessonPaths.map((path) => requiredMilestones.filter((milestone) => milestone.path === path));
    const unlockedPaths = () => {
      if (!sequentialUnlocking) return lessonPaths;
      const paths = [lessonPaths[0]];
      for (let index = 1; index < lessonPaths.length; index += 1) {
        // A lesson with no required activities is pass-through for unlocking.
        if (!lessonRequirements[index - 1].every((milestone) => completed.has(milestone.id))) break;
        paths.push(lessonPaths[index]);
      }
      return paths;
    };
    const internalNavigationKey = `${storageKey}:internal-navigation`;
    const accessNoticeKey = `${storageKey}:access-notice`;
    let internalNavigation = false;
    try {
      internalNavigation = sessionStorage.getItem(internalNavigationKey) === "1";
      sessionStorage.removeItem(internalNavigationKey);
    } catch { /* Access still follows restored progress. */ }
    const accessible = unlockedPaths();
    const knownRoute = lessonPaths.includes(currentPath);
    let redirectPath = "";
    if (knownRoute && !accessible.includes(currentPath)) {
      const requestedNumber = lessonPaths.indexOf(currentPath);
      const currentNumber = accessible.length - 1;
      redirectPath = accessible[currentNumber];
      try { sessionStorage.setItem(accessNoticeKey, `${lessons[requestedNumber]?.label} is locked. Complete ${lessons[currentNumber]?.label} before continuing.`); } catch { /* Redirect still protects the lesson. */ }
    } else if (knownRoute && launch.mode === "lms" && currentPath === "/" && !internalNavigation && launch.location !== "/" && accessible.includes(launch.location)) {
      redirectPath = launch.location;
    }
    if (redirectPath) {
      if (launch.mode === "lms" && lmsStateValid) scorm.save(toSuspendData(), redirectPath, false);
      try { sessionStorage.setItem(internalNavigationKey, "1"); } catch { /* The route remains guarded. */ }
      window.location.replace(courseUrl(redirectPath));
      return;
    }
    root.closest<HTMLElement>(".course-page")?.removeAttribute("data-access-pending");
    try {
      const notice = sessionStorage.getItem(accessNoticeKey);
      const noticeNode = document.querySelector<HTMLElement>("[data-access-notice]");
      if (notice && noticeNode) { noticeNode.textContent = notice; noticeNode.hidden = false; }
      sessionStorage.removeItem(accessNoticeKey);
    } catch { /* The course remains accessible without the redirect notice. */ }
    let leavingForLesson = false;
    let beforeUnloadStarted = false;
    const isLessonDocumentUrl = (url: string, reload = false) => {
      try {
        const destination = new URL(url, location.href);
        if (destination.origin !== location.origin || !lessonPaths.some((path) => courseUrl(path) === destination.pathname)) return false;
        if (reload) return true;
        // Hash changes stay in this document and must not affect a later exit.
        return destination.pathname !== location.pathname || destination.search !== location.search ||
          (!destination.hash && !location.hash);
      } catch { return false; }
    };
    // The Navigation API also sees reloads and Back/Forward traversals. Keep
    // the click fallback for browsers that do not expose it.
    const navigation = (window as Window & { navigation?: EventTarget }).navigation;
    navigation?.addEventListener("navigate", ((event: Event & { destination?: { url?: string }; navigationType?: string }) => {
      leavingForLesson = Boolean(event.destination?.url && isLessonDocumentUrl(event.destination.url, event.navigationType === "reload"));
      queueMicrotask(() => { if (event.defaultPrevented) leavingForLesson = false; });
    }) as EventListener);
    navigation?.addEventListener("navigateerror", () => { leavingForLesson = false; });
    navigation?.addEventListener("navigatesuccess", () => { leavingForLesson = false; });
    document.addEventListener("click", (event: MouseEvent) => {
      if (navigation) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[href]");
      if (!link) return;
      queueMicrotask(() => {
        // Keep the intent through slow document loads. A later canceled,
        // modified, new-tab, hash, or external link clears stale intent.
        leavingForLesson = !event.defaultPrevented && event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
          !link.hasAttribute("download") && (!link.target || link.target === "_self") && isLessonDocumentUrl(link.href);
      });
    });
    window.addEventListener("beforeunload", () => { beforeUnloadStarted = true; });
    window.addEventListener("focus", () => {
      // A dismissed beforeunload prompt returns focus to this document.
      if (beforeUnloadStarted) { leavingForLesson = false; beforeUnloadStarted = false; }
    });
    const trigger = root.querySelector<HTMLButtonElement>("[data-progress-trigger]");
    const panel = root.querySelector<HTMLElement>("[data-progress-panel]");
    const closeButton = root.querySelector<HTMLButtonElement>("[data-progress-close]");
    const progressValue = root.querySelector<HTMLElement>("[data-progress-value]");
    const barFill = root.querySelector<HTMLElement>("[data-progress-bar-fill]");
    const bar = root.querySelector<HTMLElement>("[data-progress-bar]");
    const lessonsNode = root.querySelector<HTMLElement>("[data-progress-lessons]");
    const courseCount = root.querySelector<HTMLElement>("[data-progress-course-count]");
    const saveError = root.querySelector<HTMLElement>("[data-progress-save-error]");
    const showSaveError = (message: string) => {
      if (!saveError) return;
      saveError.textContent = message;
      saveError.hidden = false;
    };
    if (discardedLegacyUi) showSaveError("Saved activity positions exceeded the current LMS limit and were discarded. Earned course progress was preserved.");
    if (launch.mode === "failed") showSaveError("LMS progress is unavailable. Reopen the course from your learning platform before continuing.");
    if (launch.mode === "lms" && !lmsStateValid) showSaveError("Saved LMS progress could not be read. Reopen the course from your learning platform before continuing.");

    const milestoneFor = (id: string) => milestones.find((milestone) => milestone.id === id);
    const targetFor = (milestone: Milestone) => milestone.path && milestone.path !== currentPath ? null : document.getElementById(milestone.targetId);
    const validatedTargets = new Set<string>();
    milestones.forEach((milestone) => {
      if (milestone.path && milestone.path !== currentPath) return;
      const target = targetFor(milestone);
      let problem = "";
      if (!target) problem = `Unresolved target "${milestone.targetId}" for milestone "${milestone.id}".`;
      else if (target.dataset.completionId !== milestone.id) problem = `Target "${milestone.targetId}" must declare data-completion-id="${milestone.id}".`;
      else if (milestone.type === "watch" && !(target instanceof HTMLVideoElement)) problem = `WATCH target "${milestone.targetId}" must be a video.`;
      else if (milestone.type === "submit" && !((target instanceof HTMLFormElement ? target : target.querySelector("form"))?.querySelector("[data-completion-option]"))) problem = `SUBMIT target "${milestone.targetId}" needs a form with a completion option.`;
      else if (milestone.type === "complete" && target.dataset.completionTrigger !== "complete") problem = `COMPLETE target "${milestone.targetId}" must declare data-completion-trigger="complete".`;
      else if (milestone.type === "explore") {
        let children: string[] = [];
        try { children = JSON.parse(target.dataset.requiredItems || "[]"); } catch { /* Report below. */ }
        const declared = milestone.requiredItems || [];
        const rendered = [...target.querySelectorAll<HTMLElement>("[data-flip-id], [data-step-id], [data-item-choice], [data-reveal-id], [data-carousel-id], [data-explore-item]")]
          .map((node) => node.dataset.flipId || node.dataset.stepId || node.dataset.itemChoice || node.dataset.revealId || node.dataset.carouselId || node.dataset.exploreItem);
        const actionable = (id: string) => [...target.querySelectorAll<HTMLElement>("[data-flip-id], [data-step-id], [data-item-choice], [data-reveal-id], [data-carousel-id], [data-explore-item]")]
          .some((node) => (node.dataset.flipId || node.dataset.stepId || node.dataset.itemChoice || node.dataset.revealId || node.dataset.carouselId || node.dataset.exploreItem) === id &&
            (node instanceof HTMLButtonElement || Boolean(node.querySelector("button")) || Boolean(node.dataset.carouselId && target.querySelector("[data-carousel-next], [data-carousel-prev]"))));
        if (!Array.isArray(children) || !children.length || children.length !== declared.length || declared.some((id, index) => children[index] !== id) || declared.some((id) => !rendered.includes(id) || !actionable(id))) problem = `EXPLORE target "${milestone.targetId}" has missing or mismatched required children or triggers.`;
      }
      if (problem) { console.error(`[course-progress] ${problem}`); showSaveError(`Course activity setup error: ${problem}`); }
      else validatedTargets.add(milestone.id);
    });
    sections.forEach((section) => {
      if (!section.milestoneIds.some((id) => milestones.some((item) => item.id === id && item.path === currentPath))) return;
      if (!document.getElementById(section.id)) {
        const problem = `Unresolved progress section "${section.id}".`;
        console.error(`[course-progress] ${problem}`);
        showSaveError(`Course activity setup error: ${problem}`);
      }
    });

    const mergeRanges = (ranges: RangePair[]) => {
      const clean = ranges.filter(([start, end]) => Number.isFinite(start) && Number.isFinite(end) && end > start).sort((a, b) => a[0] - b[0]);
      const merged: RangePair[] = [];
      for (const [start, end] of clean) {
        const last = merged[merged.length - 1];
        if (!last || start > last[1]) merged.push([start, end]);
        else last[1] = Math.max(last[1], end);
      }
      return merged;
    };

    const watchedFraction = (id: string, duration: number) => {
      if (!Number.isFinite(duration) || duration <= 0) return 0;
      return Math.min(1, mergeRanges(state.watchRanges[id] || []).reduce((total, [start, end]) => total + Math.max(0, end - start), 0) / duration);
    };

    const persist = (allowCompletion = false): boolean => {
      if (parentManaged && scorm.parentClosing) return true;
      state.completed = Array.from(completed);
      if (!validState(state)) {
        showSaveError("Progress state is invalid and was not saved. Reopen the course or contact support; earned requirements were not discarded.");
        return false;
      }
      if (launch.mode === "standalone") {
        try {
          window.localStorage.setItem(storageKey, JSON.stringify(state));
          if (saveError) saveError.hidden = true;
          return true;
        } catch {
          showSaveError("Progress could not be saved in this browser. Keep this page open and try the activity again.");
          return false;
        }
      }
      if (launch.mode === "lms" && lmsStateValid) {
        let payload = toSuspendData();
        let optionalUiDropped = false;
        if (payload.length > maxSuspendChars && Object.keys(state.ui).length) {
          const essential = { ...state, ui: {} };
          const essentialPayload = toSuspendData(essential);
          if (essentialPayload.length <= maxSuspendChars) { payload = essentialPayload; optionalUiDropped = true; }
        }
        if (payload.length > maxSuspendChars) {
          showSaveError(`Required progress needs ${payload.length} LMS characters; SCORM 1.2 permits ${maxSuspendChars}. Nothing was truncated or sent. Contact the course owner.`);
          return false;
        }
        const saved = scorm.save(payload, currentPath, allowCompletion && requiredMilestones.length > 0 && requiredMilestones.every((milestone) => completed.has(milestone.id)));
        if (saved && optionalUiDropped) {
          state.ui = {};
          showSaveError("Required progress was saved, but optional activity positions exceeded LMS capacity and were not retained.");
        } else if (saved && saveError) saveError.hidden = true;
        if (!saved) showSaveError("Progress could not be saved to the LMS. Keep this page open and try the activity again.");
        return saved;
      }
      return false;
    };

    const setPanelOpen = (isOpen: boolean, returnFocus = true) => {
      if (!panel) return;
      const wasOpen = panel.dataset.open === "true";
      panel.dataset.open = String(isOpen);
      panel.hidden = !isOpen;
      panel.inert = !isOpen;
      panel.setAttribute("aria-hidden", String(!isOpen));
      trigger?.setAttribute("aria-expanded", String(isOpen));
      if (isOpen) {
        window.dispatchEvent(new CustomEvent("course-progress:panel-open"));
        closeButton?.focus();
      } else if (wasOpen && returnFocus) trigger?.focus();
    };

    const renderLessons = () => {
      if (!lessonsNode) return;
      const openCompleted = new Set(Array.from(lessonsNode.querySelectorAll<HTMLDetailsElement>("details[data-completed-lesson][open]"), (details) => details.dataset.completedLesson));
      const scrollTop = panel?.scrollTop || 0;
      lessonsNode.replaceChildren();
      lessons.forEach((lesson, index) => {
        const requirements = requiredMilestones.filter((milestone) => milestone.path === lesson.path);
        const done = requirements.filter((milestone) => completed.has(milestone.id)).length;
        const percent = requirements.length ? Math.round((done / requirements.length) * 100) : 0;
        const locked = !unlockedPaths().includes(lesson.path);
        const status = locked ? "Locked" : requirements.length === 0 ? "No required activities" : done === 0 ? "Not started" : done === requirements.length ? "Completed" : "In progress";
        const item = document.createElement("section");
        item.className = "course-progress__lesson";
        item.dataset.progressLesson = lesson.id;
        item.dataset.lessonState = status.toLowerCase().replace(" ", "-");
        const head = document.createElement("div");
        head.className = "course-progress__lesson-head";
        const link = document.createElement(locked ? "span" : "a");
        if (link instanceof HTMLAnchorElement) {
          link.href = courseUrl(lesson.path);
          link.addEventListener("click", () => setPanelOpen(false, false));
        }
        link.textContent = lesson.label;
        if (locked) {
          const lock = document.createElement("span");
          lock.className = "course-progress__lock";
          lock.setAttribute("aria-hidden", "true");
          lock.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="11" x="5" y="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>';
          link.prepend(lock);
        }
        const number = document.createElement("strong");
        number.textContent = `${done}/${requirements.length}`;
        number.setAttribute("aria-label", `${done} of ${requirements.length} required activities completed`);
        head.append(link, number);
        const track = document.createElement("div");
        track.className = "course-progress__lesson-bar";
        track.setAttribute("role", "progressbar");
        track.setAttribute("aria-label", `${lesson.label} progress`);
        track.setAttribute("aria-valuemin", "0");
        track.setAttribute("aria-valuemax", "100");
        track.setAttribute("aria-valuenow", String(percent));
        const fill = document.createElement("span");
        fill.style.width = `${percent}%`;
        track.append(fill);
        const detail = document.createElement("p");
        detail.textContent = locked ? `Locked · Complete ${lessons[index - 1]?.label} before continuing` : requirements.length ? `${status} · ${percent}%` : status;
        item.append(head, track, detail);
        if (requirements.length) {
          const outstanding = requirements.filter((milestone) => !completed.has(milestone.id));
          const finished = requirements.filter((milestone) => completed.has(milestone.id));
          if (outstanding.length) {
            const toDo = document.createElement("div");
            toDo.className = "course-progress__activity-group";
            const heading = document.createElement("h3");
            heading.textContent = "Still to do";
            const list = document.createElement("ul");
            let previousSection = "";
            outstanding.forEach((milestone) => {
              const section = sections.find((item) => item.milestoneIds.includes(milestone.id));
              if (section && section.id !== previousSection) {
                const sectionRow = document.createElement("li");
                sectionRow.className = "course-progress__section-row";
                const sectionLink = document.createElement(locked ? "span" : "a");
                sectionLink.textContent = section.label;
                if (sectionLink instanceof HTMLAnchorElement) {
                  sectionLink.href = `${courseUrl(lesson.path)}#${encodeURIComponent(section.id)}`;
                  sectionLink.dataset.checklistTarget = section.id;
                  sectionLink.dataset.checklistPath = lesson.path;
                }
                sectionRow.append(sectionLink);
                list.append(sectionRow);
                previousSection = section.id;
              }
              const row = document.createElement("li");
              const activity = document.createElement(locked ? "span" : "a");
              activity.textContent = milestone.label;
              if (activity instanceof HTMLAnchorElement) {
                activity.href = `${courseUrl(lesson.path)}#${encodeURIComponent(milestone.targetId)}`;
                activity.dataset.checklistTarget = milestone.targetId;
                activity.dataset.checklistPath = lesson.path;
              }
              row.append(activity);
              list.append(row);
            });
            toDo.append(heading, list);
            item.append(toDo);
          } else {
            const allDone = document.createElement("p");
            allDone.className = "course-progress__all-done";
            allDone.textContent = "All required activities completed.";
            item.append(allDone);
          }
          if (finished.length) {
            const completeGroup = document.createElement("details");
            completeGroup.className = "course-progress__completed-group";
            completeGroup.dataset.completedLesson = lesson.id;
            completeGroup.open = openCompleted.has(lesson.id);
            const summary = document.createElement("summary");
            summary.textContent = `Completed (${finished.length})`;
            const list = document.createElement("ul");
            finished.forEach((milestone) => {
              const row = document.createElement("li");
              const tick = document.createElement("span");
              tick.className = "course-progress__completed-tick";
              tick.setAttribute("aria-hidden", "true");
              tick.textContent = "✓";
              const label = document.createElement("span");
              label.textContent = milestone.label;
              row.append(tick, label);
              list.append(row);
            });
            completeGroup.append(summary, list);
            item.append(completeGroup);
          } else {
            const noCompleted = document.createElement("p");
            noCompleted.className = "course-progress__none-completed";
            noCompleted.textContent = "Completed: None yet";
            item.append(noCompleted);
          }
        }
        lessonsNode.append(item);
      });
      if (panel) panel.scrollTop = scrollTop;
    };

    const focusActivity = (targetId: string) => {
      const target = document.getElementById(targetId);
      if (!target) return;
      // Activities may reveal a hidden panel in response to this existing hook.
      if (target.closest("[hidden]")) window.dispatchEvent(new CustomEvent("course-progress:reveal-target", { detail: { targetId } }));
      window.requestAnimationFrame(() => {
        if (target.closest("[hidden]")) return;
        const destination = target.querySelector<HTMLElement>("h2, h3, textarea, input, select, button, video") || target;
        const hadTabIndex = destination.hasAttribute("tabindex");
        if (!hadTabIndex) destination.tabIndex = -1;
        destination.focus({ preventScroll: true });
        if (!hadTabIndex) destination.addEventListener("blur", () => destination.removeAttribute("tabindex"), { once: true });
        target.scrollIntoView({ block: "start", behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth" });
        target.dataset.checklistHighlight = "true";
        window.setTimeout(() => { delete target.dataset.checklistHighlight; }, 2500);
      });
    };

    lessonsNode?.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-checklist-target]");
      if (!link || !lessonsNode.contains(link)) return;
      if (!unlockedPaths().includes(link.dataset.checklistPath || "")) { event.preventDefault(); return; }
      if (link.dataset.checklistPath !== currentPath) return;
      event.preventDefault();
      setPanelOpen(false, false);
      history.replaceState(null, "", `#${encodeURIComponent(link.dataset.checklistTarget || "")}`);
      focusActivity(link.dataset.checklistTarget || "");
    });

    const focusLinkedActivity = () => {
      let targetId = "";
      try { targetId = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      if (requiredMilestones.some((milestone) => milestone.path === currentPath && milestone.targetId === targetId) ||
        sections.some((section) => section.id === targetId && section.milestoneIds.some((id) => milestones.some((item) => item.id === id && item.path === currentPath)))) focusActivity(targetId);
    };
    if (document.readyState === "complete") window.requestAnimationFrame(focusLinkedActivity);
    else window.addEventListener("load", focusLinkedActivity, { once: true });

    const publishState = () => window.dispatchEvent(new CustomEvent("course-progress:state", {
      detail: { completedIds: Array.from(completed), unlockedPaths: unlockedPaths(), milestones: milestones.map(({ id, path, required }) => ({ id, path, required })) },
    }));
    window.addEventListener("course-progress:request-state", publishState);

    const render = () => {
      const completeCount = requiredMilestones.filter((milestone) => completed.has(milestone.id)).length;
      const percent = requiredMilestones.length === 0 ? 0 : Math.round((completeCount / requiredMilestones.length) * 100);
      const value = `${percent}% complete`;
      const percentNode = trigger?.querySelector("strong");
      if (percentNode) percentNode.textContent = `${percent}%`;
      trigger?.setAttribute("aria-label", `Open activity progress (${value})`);
      if (progressValue) progressValue.textContent = value;
      if (courseCount) courseCount.textContent = `Course required activities: ${completeCount} of ${requiredMilestones.length} completed`;
      if (barFill) barFill.style.width = `${percent}%`;
      bar?.setAttribute("aria-valuenow", String(percent));
      renderLessons();
      publishState();
    };

    const markComplete = (id: string): boolean => {
      if (launch.mode === "failed" || (launch.mode === "lms" && !lmsStateValid) || !validatedTargets.has(id)) return false;
      if (completed.has(id)) return true;
      completed.add(id);
      const saved = persist(true);
      if (!saved) {
        completed.delete(id);
        state.completed = Array.from(completed);
      }
      render();
      return saved;
    };

    const sharedState = {
      mode: launch.mode,
      learnerId: launch.learnerId,
      get: <T,>(key: string, fallback: T): T => (state.ui[key] === undefined ? fallback : state.ui[key] as T),
      set: (key: string, value: unknown) => {
        const previous = state.ui;
        state.ui = { ...previous, [key]: value };
        if (!validUi(state.ui)) {
          state.ui = previous;
          showSaveError("Optional activity state is too large or invalid to save. Required progress is unchanged.");
          return;
        }
        if (!persist()) state.ui = previous;
      },
      explored: (activityId: string) => state.explored[activityId] || [],
      completed: (activityId: string) => completed.has(activityId),
    };
    provideCourseState(sharedState);
    if (import.meta.env.PUBLIC_COURSE_VERIFY === "1") window.addEventListener("course-progress:test-set-ui", ((event: CustomEvent<{ key: string; value: unknown }>) => sharedState.set(event.detail.key, event.detail.value)) as EventListener);

    window.addEventListener("course-progress:request-restore", ((event: CustomEvent<{ activityId: string; apply?: (itemIds: string[]) => void }>) => {
      const id = event.detail.activityId;
      if (!milestoneFor(id)) return;
      event.detail.apply?.(state.explored[id] || []);
      window.dispatchEvent(new CustomEvent("course-progress:explore-state", { detail: { activityId: id, itemIds: state.explored[id] || [] } }));
      window.dispatchEvent(new CustomEvent("course-progress:restore-complete", { detail: { activityId: id, complete: completed.has(id) } }));
    }) as EventListener);

    window.addEventListener("course-progress:explore", ((event: CustomEvent<{ activityId: string; itemId: string }>) => {
      const { activityId, itemId } = event.detail;
      const milestone = milestoneFor(activityId);
      if (!milestone || milestone.type !== "explore" || !itemId) return;
      const target = targetFor(milestone);
      let requiredItems: string[] = [];
      try { requiredItems = target ? JSON.parse(target.dataset.requiredItems || "[]") : []; } catch { console.error(`[course-progress] Invalid required-item data for "${activityId}".`); }
      if (!requiredItems.includes(itemId)) return;
      const previousItems = state.explored[activityId] || [];
      if (previousItems.includes(itemId)) return;
      const itemIds = new Set(previousItems);
      itemIds.add(itemId);
      state.explored[activityId] = Array.from(itemIds);
      const saved = requiredItems.length > 0 && requiredItems.every((id) => itemIds.has(id)) && !completed.has(activityId) ? markComplete(activityId) : persist();
      if (!saved) state.explored[activityId] = previousItems;
      window.dispatchEvent(new CustomEvent("course-progress:explore-state", { detail: { activityId, itemIds: state.explored[activityId] } }));
    }) as EventListener);

    window.addEventListener("course-progress:complete", ((event: CustomEvent<{ activityId: string }>) => {
      const milestone = milestoneFor(event.detail.activityId);
      if (milestone?.type === "complete" || milestone?.type === "optional") markComplete(milestone.id);
    }) as EventListener);

    trigger?.addEventListener("click", () => setPanelOpen(panel?.dataset.open !== "true"));
    closeButton?.addEventListener("click", () => setPanelOpen(false));
    window.addEventListener("course-progress:close-panel", () => setPanelOpen(false, false));
    document.addEventListener("pointerdown", (event) => {
      if (panel?.dataset.open === "true" && !root.contains(event.target as Node)) setPanelOpen(false, false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && panel?.dataset.open === "true") setPanelOpen(false);
    });
    window.matchMedia("(max-width: 64rem)").addEventListener("change", () => setPanelOpen(false, false));

    const resetForTests = () => {
      completed.clear();
      state = defaultState();
      try { window.localStorage.removeItem(storageKey); } catch { /* In-memory state is still reset. */ }
      document.querySelectorAll<HTMLVideoElement>("video[data-completion-id]").forEach((video) => { try { video.currentTime = 0; } catch {} });
      window.dispatchEvent(new CustomEvent("course-progress:reset"));
      render();
    };
    if (import.meta.env.DEV || import.meta.env.PUBLIC_COURSE_VERIFY === "1") window.addEventListener("course-progress:test-reset", resetForTests);

    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") persist(); });
    if (parentManaged) scorm.registerFinalSave(() => { persist(false); });
    window.addEventListener("pagehide", () => {
      if (parentManaged) {
        persist(false);
        if (leavingForLesson) try { sessionStorage.setItem(internalNavigationKey, "1"); } catch { /* The next page can still restore its state. */ }
        leavingForLesson = false;
        beforeUnloadStarted = false;
        return;
      }
      if (leavingForLesson) {
        persist(false);
        try { sessionStorage.setItem(internalNavigationKey, "1"); } catch { /* The next page can still probe the active API. */ }
      } else {
        persist(false);
        scorm.exit(null, currentPath);
      }
      leavingForLesson = false;
      beforeUnloadStarted = false;
    });
    window.addEventListener("pageshow", (event) => {
      leavingForLesson = false;
      beforeUnloadStarted = false;
      if (!event.persisted) return;
      try { sessionStorage.setItem(internalNavigationKey, "1"); } catch { /* A reload still restores LMS state. */ }
      window.location.reload();
    });

    if ("IntersectionObserver" in window) {
      const viewTargets = milestones.filter((milestone) => milestone.type === "view").map((milestone) => targetFor(milestone)).filter((target): target is HTMLElement => target instanceof HTMLElement);
      const intersectingTargets = new Set<HTMLElement>();
      const visiblyRendered = (target: HTMLElement) => {
        if (!target.isConnected) return false;
        // Visibility inherits but a descendant may explicitly restore it; the other hiding styles cannot be overridden by a child.
        const targetVisibility = getComputedStyle(target).visibility;
        if (targetVisibility === "hidden" || targetVisibility === "collapse") return false;
        for (let node: HTMLElement | null = target; node; node = node.parentElement) {
          if (node.hasAttribute("hidden")) return false;
          const style = getComputedStyle(node);
          if (style.display === "none" || style.contentVisibility === "hidden" || Number(style.opacity) === 0) return false;
        }
        return true;
      };
      const creditVisibleView = (target: HTMLElement) => {
        const id = target.dataset.completionId;
        if (id && !completed.has(id) && intersectingTargets.has(target) && document.visibilityState === "visible" && visiblyRendered(target)) markComplete(id);
      };
      const viewObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const target = entry.target as HTMLElement;
          if (entry.isIntersecting) { intersectingTargets.add(target); creditVisibleView(target); }
          else intersectingTargets.delete(target);
        });
      }, { rootMargin: "-38% 0px -38% 0px", threshold: 0 });
      viewTargets.forEach((target) => viewObserver.observe(target));
      const visibilityObserver = new MutationObserver((changes) => {
        intersectingTargets.forEach((target) => {
          if (changes.some((change) => (change.target as Element).contains(target))) creditVisibleView(target);
        });
      });
      const watchedAncestors = new Set<Element>();
      viewTargets.forEach((target) => {
        for (let node: Element | null = target; node; node = node.parentElement) {
          if (watchedAncestors.has(node)) continue;
          watchedAncestors.add(node);
          visibilityObserver.observe(node, { attributes: true, attributeFilter: ["hidden", "style", "class"] });
        }
      });
      const checkAfterTransition = (event: Event) => {
        if (!(event.target instanceof Element)) return;
        intersectingTargets.forEach((target) => { if ((event.target as Element).contains(target)) creditVisibleView(target); });
      };
      document.addEventListener("transitionend", checkAfterTransition);
      document.addEventListener("transitioncancel", checkAfterTransition);
      document.addEventListener("animationend", checkAfterTransition);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") viewTargets.forEach((target) => { creditVisibleView(target); viewObserver.unobserve(target); viewObserver.observe(target); });
      });
    }

    milestones.filter((milestone) => milestone.type === "submit").forEach((milestone) => {
      const target = targetFor(milestone);
      const form = target instanceof HTMLFormElement ? target : target?.querySelector("form");
      form?.addEventListener("submit", () => {
        const selected = form.querySelector<HTMLInputElement>("input[data-completion-option]:checked");
        const selectedOption = form.querySelector<HTMLSelectElement>("select[data-completion-option]");
        if (selected || selectedOption?.value) markComplete(milestone.id);
      });
    });

    milestones.filter((milestone) => milestone.type === "watch").forEach((milestone) => {
      const video = targetFor(milestone);
      if (!(video instanceof HTMLVideoElement)) return;
      let lastPersist = 0;
      const capturePlayedRanges = () => {
        const captured: RangePair[] = [...(state.watchRanges[milestone.id] || [])];
        for (let index = 0; index < video.played.length; index += 1) captured.push([video.played.start(index), video.played.end(index)]);
        state.watchRanges[milestone.id] = mergeRanges(captured);
        if (Number.isFinite(video.duration) && video.duration > 0) state.watchDurations[milestone.id] = video.duration;
        if (watchedFraction(milestone.id, video.duration) >= (milestone.threshold ?? 0.8)) markComplete(milestone.id);
        const now = performance.now();
        if (now - lastPersist > 800) { persist(); lastPersist = now; }
        render();
      };
      video.addEventListener("loadedmetadata", render);
      video.addEventListener("timeupdate", capturePlayedRanges);
      video.addEventListener("pause", () => { capturePlayedRanges(); persist(); });
      video.addEventListener("ended", () => { capturePlayedRanges(); persist(); });
    });

    render();
    if (launch.mode === "lms" && restoredFromLms && lmsStateValid && launch.status === "incomplete" &&
      requiredMilestones.length > 0 && requiredMilestones.every((milestone) => completed.has(milestone.id) && (milestone.type !== "watch" || Boolean(state.watchDurations[milestone.id]))) &&
      milestones.filter((milestone) => milestone.path === currentPath).every((milestone) => validatedTargets.has(milestone.id)) && validState(state)) {
      // A previous commit may have saved all evidence before the status write failed.
      // Retry status only from a fully validated, nonempty restored record.
      persist(true);
    }
    window.setTimeout(() => {
      Object.entries(state.explored).forEach(([activityId, itemIds]) => window.dispatchEvent(new CustomEvent("course-progress:explore-state", { detail: { activityId, itemIds } })));
      completed.forEach((activityId) => window.dispatchEvent(new CustomEvent("course-progress:restore-complete", { detail: { activityId, complete: true } })));
    }, 0);
  });
</script>

<style>
