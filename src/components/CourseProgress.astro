  .course-progress__trigger { display: flex; min-height: 2.75rem; align-items: center; gap: 0.45rem; padding: 0.45rem 0.75rem; border: 1px solid #fff; border-radius: 0.35rem; background: transparent; color: #fff; font-size: var(--course-type-ui-size); cursor: pointer; }
  .course-progress__trigger:hover, .course-progress__trigger[aria-expanded="true"] { background: rgb(255 255 255 / 14%); }
  .course-progress__trigger span { font-size: inherit; line-height: 1; }
  .course-progress__trigger strong { font-size: inherit; line-height: 1; }
  .course-progress__panel { position: absolute; top: calc(100% + 0.75rem); right: 0; z-index: 40; width: min(340px, calc(100vw - 2rem)); max-height: min(42rem, calc(100dvh - 6.5rem)); overflow-y: auto; padding: 24px 20px; border: 1px solid #dfe5ea; border-radius: 0.35rem; background: #fff; box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 22%); color: #071827; }
  .course-progress__panel[hidden] { display: none; }
  .course-progress__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; }
  .course-progress__header p { margin: 0 0 4px; color: #435261; font-size: 13px; line-height: 1.2; }
  .course-progress__header strong { font-size: 22px; line-height: 1.1; }
  .course-progress__header .course-progress__course-count { margin: 8px 0 0; font-size: var(--course-type-compact-size); line-height: var(--course-type-compact-line-height); }
  .course-progress__close { display: grid; flex: 0 0 42px; width: 42px; height: 42px; place-items: center; padding: 0; border: 0; border-radius: 50%; background: #e1e5e7; color: var(--course-accent); font-size: 26px; line-height: 1; cursor: pointer; }
  .course-progress__close:hover, .course-progress__close:focus-visible { background: var(--course-accent); color: var(--ink); outline: 2px solid var(--focus-on-light); outline-offset: 2px; }
  .course-progress__bar { height: 10px; margin: 20px 0 18px; overflow: hidden; border-radius: 999px; background: #fff; box-shadow: inset 0 0 0 1px #6d777d; }
  .course-progress__bar span { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--course-accent); transition: width 0.2s ease; }
  .course-progress__save-error { position: absolute; top: calc(100% + .4rem); right: 0; z-index: 41; width: min(340px, calc(100vw - 2rem)); margin: 0; padding: .75rem 1rem; border: 2px solid #9d1b1b; border-radius: .35rem; color: #7d1010; background: #fff; box-shadow: 0 .4rem 1rem rgb(0 0 0 / 18%); font-size: var(--course-type-ui-size); line-height: 1.4; }
  .course-progress__save-error[hidden] { display: none; }
  .course-progress__lessons { display: grid; gap: 14px; }
  :global(.course-progress__lesson) { padding-top: 12px; border-top: 1px solid #dfe5ea; }
  :global(.course-progress__lesson-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  :global(.course-progress__lesson-head a) { color: #071827; font-size: var(--course-type-ui-size); font-weight: 700; line-height: 1.3; text-decoration: none; }
  :global(.course-progress__lesson-head > span) { display: inline-flex; align-items: center; gap: .35rem; color: #435261; font-size: var(--course-type-ui-size); font-weight: 700; line-height: 1.3; }
  :global(.course-progress__lock) { display: inline-flex; flex: 0 0 1rem; }
  :global(.course-progress__lock svg) { width: 1rem; height: 1rem; }
  :global(.course-progress__lesson-head a:hover), :global(.course-progress__lesson-head a:focus-visible) { color: var(--course-accent); text-decoration: underline; outline-color: var(--focus-on-light); }
  :global(.course-progress__lesson-head strong) { flex: 0 0 auto; font-size: var(--course-type-ui-size); }
  :global(.course-progress__lesson-bar) { height: 7px; margin-top: 8px; overflow: hidden; border-radius: 999px; background: #e1e5e7; box-shadow: inset 0 0 0 1px #6d777d; }
  :global(.course-progress__lesson-bar span) { display: block; height: 100%; border-radius: inherit; background: var(--course-accent); transition: width 0.2s ease; }
  :global(.course-progress__lesson p) { margin: 5px 0 0; color: #435261; font-size: var(--course-type-ui-size); line-height: 1.3; }
  :global(.course-progress__activity-group) { margin-top: 12px; }
  :global(.course-progress__activity-group h3) { margin: 0 0 5px; color: #071827; font-size: var(--course-type-ui-size); font-weight: 700; line-height: var(--course-type-ui-line-height); }
  :global(.course-progress__activity-group ul), :global(.course-progress__completed-group ul) { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  :global(.course-progress__activity-group li), :global(.course-progress__completed-group li) { margin: 0; font-size: var(--course-type-ui-size); line-height: var(--course-type-ui-line-height); }
  :global(.course-progress__section-row) { padding-top: .55rem; font-weight: 700; }
  :global(.course-progress__section-row:first-child) { padding-top: .15rem; }
  :global(.course-progress__section-row + li) { padding-left: .75rem; }
  :global(.course-progress__activity-group a) { color: var(--course-accent-strong); text-decoration: underline; text-underline-offset: 2px; }
  :global(.course-progress__activity-group a:hover), :global(.course-progress__activity-group a:focus-visible) { color: var(--course-accent); outline-color: var(--focus-on-light); }
  :global(.course-progress__activity-group span) { color: #435261; }
  :global(.course-progress__all-done) { margin-top: 12px !important; color: #146b51 !important; font-weight: 700; }
  :global(.course-progress__none-completed) { margin-top: 12px !important; }
  :global(.course-progress__completed-group) { margin-top: 12px; }
