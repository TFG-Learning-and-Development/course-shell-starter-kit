---
import type { ExplorerCategory, ExplorerItem } from "./premium-types";
interface Props { id: string; title: string; intro?: string; categories?: readonly ExplorerCategory[]; items: readonly ExplorerItem[] }
const { id, title, intro, categories = [], items } = Astro.props as Props;
---
<section class="premium-section" id={id} data-completion-id={id} data-required-items={JSON.stringify(items.map((item) => item.id))} data-item-explorer aria-labelledby={`${id}-heading`}>
  <div class="container"><div class="premium-section__intro"><h2 id={`${id}-heading`}>{title}</h2>{intro && <p>{intro}</p>}<p data-explorer-status aria-live="polite">0 of {items.length} items explored</p></div><div class="item-explorer">
    {categories.length > 0 && <div class="item-explorer__choices" role="tablist" aria-label={`${title} categories`}>{categories.map((category, index) => <button type="button" role="tab" data-category-choice={category.id} aria-selected={index === 0 ? "true" : "false"}>{category.label}</button>)}</div>}
    <div class="item-explorer__choices" aria-label={`${title} items`}>{items.map((item, index) => <button type="button" data-item-choice={item.id} data-item-category={item.categoryId} aria-pressed={index === 0 ? "true" : "false"}>{item.title}</button>)}</div>
    {items.map((item, itemIndex) => <article class="item-explorer__item" data-explorer-item={item.id} hidden={itemIndex !== 0}><div class="item-explorer__gallery"><img data-explorer-image src={item.images[0]?.src} alt={item.images[0]?.alt} width="800" height="600" /><div class="item-explorer__thumbs">{item.images.map((image, imageIndex) => <button type="button" data-image-src={image.src} data-image-alt={image.alt} aria-pressed={imageIndex === 0 ? "true" : "false"} aria-label={`Show image ${imageIndex + 1} of ${item.title}`}><img src={image.src} alt="" width="80" height="80" loading="lazy" /></button>)}</div></div><div class="item-explorer__details"><h3>{item.title}</h3><p>{item.summary}</p><dl>{item.details.map((detail) => <div><dt>{detail.label}</dt><dd>{detail.text}</dd></div>)}</dl></div></article>)}
  </div></div>
</section>
<script>
  import { courseStateReady } from "../lib/course-state";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-item-explorer]").forEach((root) => {
    if (root.dataset.ready === "true") return; root.dataset.ready = "true";
    const choices = [...root.querySelectorAll<HTMLButtonElement>("[data-item-choice]")]; const categories = [...root.querySelectorAll<HTMLButtonElement>("[data-category-choice]")]; const items = [...root.querySelectorAll<HTMLElement>("[data-explorer-item]")]; const status = root.querySelector<HTMLElement>("[data-explorer-status]"); const visited = new Set(courseState.explored(root.id));
    const renderStatus = () => { if (status) status.textContent = `${visited.size} of ${items.length} items explored`; };
    const show = (id: string, record = true) => { choices.forEach((choice) => choice.setAttribute("aria-pressed", String(choice.dataset.itemChoice === id))); items.forEach((item) => item.hidden = item.dataset.explorerItem !== id); courseState.set(`${root.id}:active`, id); if (record) window.dispatchEvent(new CustomEvent("course-progress:explore", { detail: { activityId: root.id, itemId: id } })); };
    choices.forEach((choice) => choice.addEventListener("click", () => { if (choice.dataset.itemChoice) show(choice.dataset.itemChoice); }));
    const showCategory = (id: string) => { categories.forEach((category) => category.setAttribute("aria-selected", String(category.dataset.categoryChoice === id))); choices.forEach((choice) => choice.hidden = Boolean(choice.dataset.itemCategory && choice.dataset.itemCategory !== id)); const selected = choices.find((choice) => !choice.hidden && choice.getAttribute("aria-pressed") === "true") || choices.find((choice) => !choice.hidden); if (selected?.dataset.itemChoice) show(selected.dataset.itemChoice); courseState.set(`${root.id}:category`, id); };
    categories.forEach((category) => category.addEventListener("click", () => { if (category.dataset.categoryChoice) showCategory(category.dataset.categoryChoice); }));
    items.forEach((item) => { const image = item.querySelector<HTMLImageElement>("[data-explorer-image]"); item.querySelectorAll<HTMLButtonElement>("[data-image-src]").forEach((button) => button.addEventListener("click", () => { if (!image || !button.dataset.imageSrc) return; image.src = button.dataset.imageSrc; image.alt = button.dataset.imageAlt || ""; item.querySelectorAll<HTMLButtonElement>("[data-image-src]").forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button))); })); });
    window.addEventListener("course-progress:explore-state", ((event: CustomEvent<{ activityId: string; itemIds: string[] }>) => { if (event.detail.activityId !== root.id) return; event.detail.itemIds.forEach((item) => visited.add(item)); renderStatus(); }) as EventListener);
    const savedCategory = courseState.get<string>(`${root.id}:category`, categories[0]?.dataset.categoryChoice || ""); if (categories.length && categories.some((category) => category.dataset.categoryChoice === savedCategory)) showCategory(savedCategory); const saved = courseState.get<string>(`${root.id}:active`, items[0]?.dataset.explorerItem || ""); if (items.some((item) => item.dataset.explorerItem === saved)) show(saved); renderStatus();
  }));
</script>
