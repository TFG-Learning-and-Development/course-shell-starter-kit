---
import type { BrandValue } from "../data/course";

interface Props {
  values: BrandValue[];
}

const { values } = Astro.props as Props;
---

<div class="match-guide" aria-label="Champion values and their matching Customer messages">
  <div class="match-guide-heading" aria-hidden="true">
    <h3>Champion Values</h3>
    <span></span>
    <h3>Customer Message</h3>
  </div>
  <div class="match-pairs">
    {values.map((value) => (
      <div class="match-pair" data-brand-pair={value.id}>
        <div class="match-value-static">{value.label}</div>
        <svg class="match-arrow" viewBox="0 0 40 24" aria-hidden="true">
          <path d="M2 12h32M27 5l7 7-7 7" />
        </svg>
        <div class="match-message-static">{value.message}</div>
      </div>
    ))}
  </div>
</div>
