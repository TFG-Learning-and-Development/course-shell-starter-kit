---
import type { ConversationExample } from "../data/course";

interface Props {
  example: ConversationExample;
}

const { example } = Astro.props as Props;
---

<article class="conversation-card">
  <svg class="conversation-icon" viewBox="0 0 72 56" aria-hidden="true" focusable="false">
    <path d="M5 7h34a5 5 0 0 1 5 5v18a5 5 0 0 1-5 5H21L10 46V35H5a5 5 0 0 1-5-5V12a5 5 0 0 1 5-5Z" />
    <path d="M31 20h34a5 5 0 0 1 5 5v18a5 5 0 0 1-5 5H54L43 55v-7H31a5 5 0 0 1-5-5V25a5 5 0 0 1 5-5Z" />
    <path d="M35 29h26M35 36h26M35 43h18" />
  </svg>
  <h3>Example {example.number}</h3>
  <p><strong>Customer:</strong> “{example.customer}”</p>
  <p><strong>You:</strong> “{example.response}”</p>
</article>
