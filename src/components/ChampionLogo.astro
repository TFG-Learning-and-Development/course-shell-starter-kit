---
interface Props {
  class?: string;
  light?: boolean;
}

const { class: className, light = false } = Astro.props as Props;
---

<img
  class:list={["champion-logo", className, light && "champion-logo--light"]}
  src="/assets/champion/champion-logo.png"
  alt="Champion — The Original Sportswear Brand™"
/>
