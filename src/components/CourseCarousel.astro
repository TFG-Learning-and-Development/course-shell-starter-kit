---
import type { EditorialMedia } from "./premium-types";
type Item = { id: string; title: string; body: string; media: EditorialMedia };
interface Props { id: string; label: string; items: readonly Item[]; tracked?: boolean }
const { id, label, items, tracked = false } = Astro.props as Props;
---
<div class="premium-carousel" id={id} data-premium-carousel data-completion-id={tracked ? id : undefined} data-required-items={tracked ? JSON.stringify(items.map((item) => item.id)) : undefined} aria-label={label}>
  {items.map((item, index) => <article class="premium-carousel__slide" data-carousel-id={item.id} hidden={index !== 0}><img src={item.media.src} alt={item.media.alt} width="800" height="600" loading="lazy" /><div class="premium-carousel__copy"><h3>{item.title}</h3><p>{item.body}</p></div></article>)}
  <div class="premium-carousel__controls"><button class="premium-action" type="button" data-carousel-prev disabled>Previous</button><span data-carousel-count aria-live="polite">1 of {items.length}</span><button class="premium-action" type="button" data-carousel-next>Next</button></div>
</div>
<script>
  import { courseStateReady } from "../lib/course-state";
  import { watchVisiblePanelExploration } from "../lib/visible-panel-exploration";
  courseStateReady.then((courseState) => document.querySelectorAll<HTMLElement>("[data-premium-carousel]").forEach((root) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const slides = [...root.querySelectorAll<HTMLElement>("[data-carousel-id]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const count = root.querySelector<HTMLElement>("[data-carousel-count]");
    let active = courseState.get<number>(`${root.id}:active`, 0);
    if (!Number.isInteger(active) || active < 0 || active >= slides.length) active = 0;
    const creditVisible = root.dataset.completionId
      ? watchVisiblePanelExploration({ root, panels: slides, activePanel: () => slides[active], itemId: (slide) => slide.dataset.carouselId, courseState })
      : () => {};
    const show = (index: number, record = true) => {
      active = index;
      slides.forEach((slide, position) => { slide.hidden = position !== index; });
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      if (count) count.textContent = `${index + 1} of ${slides.length}`;
      if (record) { courseState.set(`${root.id}:active`, index); creditVisible(); }
    };
    previous?.addEventListener("click", () => show(Math.max(0, active - 1)));
    next?.addEventListener("click", () => show(Math.min(slides.length - 1, active + 1)));
    show(active, false);
  }));
</script>
