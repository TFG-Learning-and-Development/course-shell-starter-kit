---
import CoursePage from "../components/CoursePage.astro";
import EditorialSplit from "../components/EditorialSplit.astro";
import FlipCards from "../components/FlipCards.astro";
import PortraitQuote from "../components/PortraitQuote.astro";
import PremiumAssessment from "../components/PremiumAssessment.astro";
import { courseData } from "../data/course";
import { courseConfig } from "../data/course-config";
---
<CoursePage lessonId={courseConfig.lessons[0].id}>
  <section class="hero premium-hero" id="overview" data-nav-section>
    <img class="premium-hero__image" src={courseData.hero.image.src} alt={courseData.hero.image.alt} width="1200" height="800" fetchpriority="high" />
    <div class="premium-hero__shade"></div>
    <div class="container hero-grid"><div class="hero-copy"><h1>{courseData.hero.title}</h1><p class="hero-description">{courseData.hero.description}</p><a class="button-link" href="#editorial">{courseData.hero.actionLabel}</a></div></div>
  </section>
  <div id="editorial"><EditorialSplit title={courseData.editorial.title} paragraphs={courseData.editorial.paragraphs} media={courseData.editorial.media} /></div>
  <div data-nav-section data-section-id="story"><PortraitQuote id="story" title={courseData.story.title} paragraphs={courseData.story.paragraphs} portrait={courseData.story.portrait} quote={courseData.story.quote} citation={courseData.story.citation} /></div>
  <div data-nav-section data-section-id="principles"><FlipCards id="principles" title={courseData.principles.title} intro={courseData.principles.intro} cards={courseData.principles.cards} /></div>
  <div data-nav-section data-section-id="assessment"><PremiumAssessment id="assessment" title={courseData.assessment.title} instruction={courseData.assessment.instruction} question={courseData.assessment.question} /></div>
  <script>
    const sections = [...document.querySelectorAll<HTMLElement>("[data-nav-section]")];
    const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]")];
    const setCurrent = () => { const line = scrollY + innerHeight * .5; const current = sections.reduce((selected, section) => section.offsetTop <= line ? section : selected, sections[0]); const id = current?.dataset.sectionId || current?.id; sectionLinks.forEach((link) => link.hash === `#${id}` ? link.setAttribute("aria-current", "location") : link.removeAttribute("aria-current")); };
    addEventListener("scroll", setCurrent, { passive: true }); setCurrent();
  </script>
</CoursePage>

<style>
  .premium-hero { position: relative; min-height: clamp(36rem, 78vh, 50rem); }
  .premium-hero__image, .premium-hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .premium-hero__image { object-fit: cover; }
  .premium-hero__shade { background: linear-gradient(90deg, color-mix(in srgb, var(--ink) 90%, transparent) 0%, color-mix(in srgb, var(--course-accent-strong) 72%, transparent) 48%, color-mix(in srgb, var(--course-accent) 18%, transparent) 100%); }
  .premium-hero .hero-grid { position: relative; z-index: 1; grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 48rem) { .premium-hero__shade { background: linear-gradient(90deg, color-mix(in srgb, var(--ink) 92%, transparent), color-mix(in srgb, var(--course-accent-strong) 58%, transparent)); } }
</style>
